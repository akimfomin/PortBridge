/**GEN**/

#[test]
fn empty_epoch_has_no_measurement() {
    let epoch = scratch_epoch(std::iter::empty());
    assert_eq!(epoch.counts, [0; 4]);
    assert_eq!(epoch.requested_bytes, 0);
    assert_eq!(epoch.create_ns, 0);
}

#[test]
fn separates_aligned_size_thresholds_and_keeps_elapsed_time() {
    let sizes = [60, 65_536, 65_537, 262_144, 262_145, 1_048_576, 1_048_577, 3_400_000];
    let epoch = scratch_epoch(sizes.into_iter().enumerate().map(|(i, requested_bytes)| ScratchAllocation {
        requested_bytes,
        create_ns: 10 * (i + 1) as u64,
    }));
    assert_eq!(epoch.counts, [2, 2, 2, 2]);
    assert_eq!(epoch.requested_bytes, sizes.iter().sum());
    assert_eq!(epoch.create_ns, 360);
}

#[test]
fn extreme_totals_do_not_wrap() {
    let epoch = scratch_epoch([u64::MAX, 17].into_iter().map(|n| ScratchAllocation {
        requested_bytes: n,
        create_ns: n,
    }));
    assert_eq!(epoch.counts, [1, 0, 0, 1]);
    assert_eq!(epoch.requested_bytes, u64::MAX);
    assert_eq!(epoch.create_ns, u64::MAX);
}
