+/// Kosaraju's two passes use explicit stacks. Visiting the reverse edges first
+/// orders the resulting components with each group's dependencies first.
+fn phi_components(forward: &[Vec<usize>], reverse: &[Vec<usize>]) -> Vec<Vec<usize>> {
+    let count = forward.len();
+    let mut seen = vec![false; count];
+    let mut done = Vec::with_capacity(count);
+    let mut walk = Vec::new();
+    for root in 0..count {
+        walk.push((root, false));
+        while let Some((node, exit)) = walk.pop() {
+            if exit {
+                done.push(node);
+            } else if !std::mem::replace(&mut seen[node], true) {
+                walk.push((node, true));
+                walk.extend(reverse[node].iter().map(|&p| (p, false)));
+            }
+        }
+    }
+    seen.fill(false);
+    let mut groups = Vec::new();
+    let mut work = Vec::new();
+    for root in done.into_iter().rev() {
+        if seen[root] {
+            continue;
+        }
+        let mut members = Vec::new();
+        work.push(root);
+        while let Some(node) = work.pop() {
+            if !std::mem::replace(&mut seen[node], true) {
+                members.push(node);
+                work.extend_from_slice(&forward[node]);
+            }
+        }
+        groups.push(members);
+    }
+    groups
+}
+
+fn strictly_dominates(idom: &[Option<usize>], def: usize, mut block: usize) -> bool {
+    if def == block {
+        return false;
+    }
+    while let Some(parent) = idom[block] {
+        if parent == def {
+            return true;
+        }
+        if parent == block {
+            break;
+        }
+        block = parent;
+    }
+    false
+}
