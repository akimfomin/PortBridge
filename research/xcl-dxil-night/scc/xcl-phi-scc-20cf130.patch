+#[cfg(test)]
+mod phi_scc_tests {
+    use super::*;
+    use super::super::Block;
+
+    #[derive(Clone, Copy)]
+    enum Seed { Constant, Dominating, SameBlock, Two, Missing, Undef }
+
+    fn fold(m: &Module) -> Vec<Option<Value>> {
+        let order: Vec<u32> = m.block_layout().0.into_iter().map(|b| b as u32).collect();
+        let idom = m.idoms(&order);
+        let mut repl = vec![None; m.insts.len()];
+        m.fold_phi_cycles(&order, &idom, &mut repl);
+        repl
+    }
+
+    fn check(width: usize, kind: Seed, should_fold: bool) {
+        let mut m = Module::new();
+        let ty = m.i32();
+        let a = m.i32c(17);
+        let b = m.i32c(37);
+        let mut seed = match kind {
+            Seed::Dominating => m.bin(BinOp::Add, a, b),
+            Seed::Undef => m.undef(ty),
+            _ => a,
+        };
+        let head = m.new_block();
+        m.br(head);
+        m.set_block(head);
+        let phis: Vec<_> = (0..width).map(|_| m.phi(ty)).collect();
+        // SameBlock and Missing deliberately isolate guards on malformed phi input.
+        if matches!(kind, Seed::SameBlock) {
+            seed = m.bin(BinOp::Add, a, b);
+        }
+        m.br(head);
+        for (i, &phi) in phis.iter().enumerate() {
+            if !matches!(kind, Seed::Missing) {
+                m.add_incoming(phi, if matches!(kind, Seed::Two) && i == 0 { b } else { seed }, Block(0));
+            }
+            m.add_incoming(phi, phis[(i + 1) % width], head);
+        }
+        let repl = fold(&m);
+        for phi in phis {
+            let Value::Inst(i) = phi else { unreachable!() };
+            assert_eq!(repl[i as usize], should_fold.then_some(seed));
+        }
+    }
+
+    #[test]
+    fn unique_constant_and_strictly_dominating_instruction_fold() {
+        check(2, Seed::Constant, true);
+        check(2, Seed::Dominating, true);
+    }
+
+    #[test]
+    fn two_or_no_seeds_same_block_and_undef_are_preserved() {
+        check(2, Seed::Two, false);
+        check(2, Seed::Missing, false);
+        check(2, Seed::SameBlock, false);
+        check(2, Seed::Undef, false);
+    }
+
+    #[test]
+    fn long_cycle_is_walked_without_recursion() {
+        check(4096, Seed::Constant, true);
+    }
+
+    #[test]
+    fn dependencies_collapse_before_their_users() {
+        let mut m = Module::new();
+        let ty = m.i32();
+        let seed = m.i32c(17);
+        let choose = m.i1c(true);
+        let first = m.new_block();
+        let detour = m.new_block();
+        let join = m.new_block();
+        let second = m.new_block();
+        let exit = m.new_block();
+        m.br(first);
+        m.set_block(first);
+        let x = m.phi(ty);
+        m.cond_br(choose, join, detour);
+        m.set_block(detour);
+        m.br(join);
+        m.set_block(join);
+        let y = m.phi(ty);
+        m.cond_br(choose, second, first);
+        m.set_block(second);
+        let a = m.phi(ty);
+        let b = m.phi(ty);
+        m.cond_br(choose, exit, second);
+        m.set_block(exit);
+        m.ret();
+
+        m.add_incoming(x, seed, Block(0));
+        m.add_incoming(x, y, join);
+        m.add_incoming(y, x, first);
+        m.add_incoming(y, seed, detour);
+        m.add_incoming(a, seed, join);
+        m.add_incoming(a, b, second);
+        m.add_incoming(b, y, join);
+        m.add_incoming(b, a, second);
+
+        let repl = fold(&m);
+        for phi in [a, b, x, y] {
+            let Value::Inst(i) = phi else { unreachable!() };
+            assert_eq!(repl[i as usize], Some(seed));
+        }
+    }
+}
