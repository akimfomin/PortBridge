+    /// Collapse a mutually recursive group of phis with one outside value. The
+    /// SCC criterion is from Braun et al., Compiler Construction 2013, §3.2.
+    /// Retain groups with zero or multiple outside values; instruction seeds
+    /// must also strictly dominate each phi block.
+    fn fold_phi_cycles(&self, order: &[u32], idom: &[Option<usize>], repl: &mut [Option<Value>]) {
+        let phis: Vec<usize> = order.iter().flat_map(|&b| self.blocks[b as usize].iter().copied()
+            .take_while(|&i| matches!(self.insts[i as usize].op, Op::Phi(_))))
+            .map(|i| i as usize).filter(|&i| repl[i].is_none()).collect();
+        if phis.len() < 2 {
+            return;
+        }
+        let mut phi_index = vec![usize::MAX; self.insts.len()];
+        for (node, &i) in phis.iter().enumerate() {
+            phi_index[i] = node;
+        }
+        let mut forward = vec![Vec::new(); phis.len()];
+        let mut reverse = vec![Vec::new(); phis.len()];
+        for (node, &i) in phis.iter().enumerate() {
+            let Op::Phi(inc) = &self.insts[i].op else { unreachable!() };
+            for &(v, _) in inc {
+                if let Value::Inst(other) = resolve(repl, v) {
+                    let dependency = phi_index[other as usize];
+                    if dependency != usize::MAX && dependency != node {
+                        forward[node].push(dependency);
+                        reverse[dependency].push(node);
+                    }
+                }
+            }
+        }
+        let components = phi_components(&forward, &reverse);
+        let mut owner = vec![usize::MAX; phis.len()];
+        for (group, members) in components.iter().enumerate() {
+            for &node in members {
+                owner[node] = group;
+            }
+        }
+        'groups: for (group, members) in components.iter().enumerate() {
+            if members.len() < 2 {
+                continue;
+            }
+            let mut seed = None;
+            for &node in members {
+                let Op::Phi(inc) = &self.insts[phis[node]].op else { unreachable!() };
+                for &(v, _) in inc {
+                    let v = resolve(repl, v);
+                    if let Value::Inst(i) = v {
+                        let other = phi_index[i as usize];
+                        if other != usize::MAX && owner[other] == group {
+                            continue;
+                        }
+                    }
+                    if seed.is_some_and(|s| s != v) {
+                        continue 'groups;
+                    }
+                    seed = Some(v);
+                }
+            }
+            let Some(seed) = seed else { continue };
+            let seed_block = match seed {
+                Value::Inst(_) => match self.def_block(seed) {
+                    Some(b) => Some(b.0 as usize),
+                    None => continue,
+                },
+                Value::Const(c) if matches!(self.consts[c as usize],
+                    super::ConstDef::Int(..) | super::ConstDef::Float(..) | super::ConstDef::Null(..)) => None,
+                _ => continue,
+            };
+            if !members.iter().all(|&node| {
+                let i = phis[node];
+                self.insts[i].ty == self.value_ty(seed) && seed_block.is_none_or(|def| {
+                    strictly_dominates(idom, def, self.def_block[i].0 as usize)
+                })
+            }) {
+                continue;
+            }
+            for &node in members {
+                repl[phis[node]] = Some(seed);
+            }
+        }
+    }
