+#[cfg(test)]
+mod tests {
+    use super::guarded_offset;
+
+    #[test]
+    fn guarded_taken_offsets_round_trip_with_their_sign() {
+        for offset in [-0x3fff_ffffi32, -9, -1, 0, 1, 9, 0x3fff_ffff] {
+            for header in [false, true] {
+                let word = guarded_offset(offset as u32, header);
+                assert_eq!(word as i32 >> 1, offset);
+                assert_eq!(word & 1 != 0, header);
+            }
+        }
+        assert_eq!(guarded_offset(0, false), 0);
+    }
+}
diff --git a/crates/xcl/src/gpu/dxil/compact_tests.rs b/crates/xcl/src/gpu/dxil/compact_tests.rs
index 2fd26c9..f5a44ee 100644
--- a/crates/xcl/src/gpu/dxil/compact_tests.rs
+++ b/crates/xcl/src/gpu/dxil/compact_tests.rs
@@ -95,3 +95,25 @@ fn a_mask_read_whole_after_one_copy_only_splits_the_class() {
     assert_eq!(p.order.len(), 4);
     assert_ne!(p.class[0], p.class[2]);
 }
+
+#[test]
+fn a_loop_header_keeps_its_guard_when_blocks_share_a_class_and_offsets() {
+    let i = |n: &str, e: &str, f: &[(&str, u64)]| encode(n, e, f, None).unwrap_or_else(|x| panic!("{n}: {x}"));
+    let mut code = i("S_BRANCH", "ENC_SOPP", &[("SIMM16", 0)]);
+    for _ in 0..2 {
+        code.extend(i("S_ADD_U32", "ENC_SOP2", &[("SDST", 0), ("SSRC0", 0), ("SSRC1", 129)]));
+        code.extend(i("S_BRANCH", "ENC_SOPP", &[("SIMM16", 0)]));
+    }
+    code.extend(i("S_CBRANCH_SCC1", "ENC_SOPP", &[("SIMM16", 0xFFFD)]));
+    code.extend(i("S_ENDPGM", "ENC_SOPP", &[]));
+    let cfg = super::cfg::Cfg::build(&code).unwrap();
+    let leaders = cfg.blocks.iter().filter_map(|b| b.insts.first().map(|&i| cfg.insts[i].pc)).collect();
+    let o = KernelOptions { wave64: false, split: false, mem_windows: 1, sampler_base: 0 };
+    let lw = super::lower::Lw::new(&cfg.insts, &leaders, o, &super::kernel::Entry::Kernel);
+    let p = super::compact::plan(&cfg, &lw).unwrap();
+    assert!(!cfg.headers.contains(&p.order[1]));
+    assert!(cfg.headers.contains(&p.order[2]));
+    assert_eq!(p.class[1], p.class[2]);
+    assert!(p.steps.contains(&(1, 1, false)));
+    assert!(p.steps.contains(&(1, 1, true)));
+}
