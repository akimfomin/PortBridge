+def _fma(a, b, c):
+    """Prépare l'arrondi unique d'un produit-somme de trois entrées f32."""
+    product = a * b                       # au plus 48 bits significatifs, exact en f64
+    total = product + c
+    # FastTwoSum : on place la plus grande magnitude en premier pour retrouver
+    # l'erreur exacte de la somme. Si elle est nulle, un seul arrondi reste à faire.
+    if abs(product) < abs(c):
+        product, c = c, product
+    error = c - (total - product)
+    if not error or not _F32_HALF_MIN_SUBNORMAL <= abs(total) <= _F32_OUT_OF_RANGE:
+        return total
