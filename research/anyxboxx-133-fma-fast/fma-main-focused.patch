-def _fma(a, b, c):
+def _mul_add(a, b, c):
     return a * b + c
 
 
+# 53 bits en f64, 24 en f32. Le facteur convertit une ULP f64 en une demi-ULP f32.
+_F32_HALF_ULP_SCALE = 2.0 ** (53 - 24 - 1)
+_F32_HALF_MIN_SUBNORMAL = 2.0 ** -150
+_F32_OUT_OF_RANGE = 2.0 ** 128
+
+
+def _fma(a, b, c):
+    """Prépare l'arrondi unique d'un produit-somme de trois entrées f32."""
+    product = a * b
+    total = product + c
+    # Le produit de 24 bits par 24 bits est exact en f64. FastTwoSum retrouve
+    # l'erreur de la somme en plaçant la plus grande magnitude en premier.
+    if abs(product) < abs(c):
+        product, c = c, product
+    error = c - (total - product)
+    if not error or not _F32_HALF_MIN_SUBNORMAL <= abs(total) <= _F32_OUT_OF_RANGE:
+        return total
+
+    half_ulp = math.ulp(total) * _F32_HALF_ULP_SCALE
+    if half_ulp < _F32_HALF_MIN_SUBNORMAL:
+        half_ulp = _F32_HALF_MIN_SUBNORMAL
+    if total % (half_ulp + half_ulp) != half_ulp:
+        return total
+    return math.nextafter(total, math.copysign(math.inf, error))
+
+
