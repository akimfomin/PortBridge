+    fn for_each_copy_span(&self, m: &MipLayout, slice: u32, mut copy: impl FnMut(usize, usize, usize)) {
+        let bpe = self.desc.element_bytes as usize;
+        let mip_base = self.slice_size * u64::from(slice) + m.offset;
+        if self.desc.swizzle == SwizzleMode::Linear {
+            let row_bytes = m.width_elements as usize * bpe;
+            let pitch_bytes = u64::from(m.pitch_elements) * bpe as u64;
+            for y in 0..m.height_elements {
+                copy((mip_base + u64::from(y) * pitch_bytes) as usize, y as usize * row_bytes, row_bytes);
+            }
+            return;
+        }
+
+        let block_log2 = self.desc.swizzle.block_log2();
+        let in_tail = m.tail.is_some();
+        let (origin_x, origin_y) = m.tail.map_or((0, 0), |tail| (tail.x, tail.y));
+        if m.width_elements <= 2 && m.height_elements <= 2
+            && (in_tail || (m.width_elements <= self.block_width && m.height_elements <= self.block_height))
+        {
+            // Quelques éléments dans un bloc : le calcul direct évite la table des colonnes.
+            let mut linear_offset = 0;
+            for y in 0..m.height_elements {
+                for x in 0..m.width_elements {
+                    let offset = self.equation.eval_byte_offset(x + origin_x, y + origin_y, slice) ^ self.effective_xor;
+                    copy((mip_base + offset as u64) as usize, linear_offset, bpe);
+                    linear_offset += bpe;
+                }
+            }
+            return;
+        }
+        let pitch_blocks = if in_tail { 0 } else { m.pitch_elements / self.block_width };
+        // L'équation GFX10 est linéaire sur GF(2). X, Y et la tranche se combinent par XOR,
+        // avec les coordonnées entières pour conserver les bits d'entrelacement des pipes.
+        let columns: Vec<_> = (0..m.width_elements)
+            .map(|x| {
+                let block = if in_tail { 0 } else { u64::from(x / self.block_width) << block_log2 };
+                (block, self.equation.eval_byte_offset(x + origin_x, 0, 0))
+            })
+            .collect();
+        let slice_xor = self.equation.eval_byte_offset(0, 0, slice) ^ self.effective_xor;
+        let mut linear_offset = 0;
+        for y in 0..m.height_elements {
+            let block = if in_tail { 0 } else { u64::from(y / self.block_height) * u64::from(pitch_blocks) };
+            let row_base = mip_base + (block << block_log2);
+            let row_xor = self.equation.eval_byte_offset(0, y + origin_y, 0) ^ slice_xor;
+            for &(column_block, column_xor) in &columns {
+                let tiled_offset = row_base + column_block + (column_xor ^ row_xor) as u64;
+                copy(tiled_offset as usize, linear_offset, bpe);
+                linear_offset += bpe;
+            }
+        }
+    }
