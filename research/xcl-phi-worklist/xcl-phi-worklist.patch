+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::gpu::dxil::module::Block;
+
+    #[test]
+    fn phi_worklist_closes_backward_chains_and_preserves_a_live_cycle() {
+        for after_cse in [false, true] {
+            let mut m = Module::new();
+            m.define_entry("main");
+            let ty = m.i32();
+            let void = m.void();
+            let sink_ty = m.func_ty(void, &[ty, ty]);
+            let sink = m.declare("observe", sink_ty, FnAttrs::None);
+            let seed = m.i32c(23);
+            let different = m.i32c(29);
+            let zero = m.i32c(0);
+            let one = m.i32c(1);
+            let two = m.i32c(2);
+            let tail = if after_cse { m.bin(BinOp::Add, seed, zero) } else { seed };
+            let header = m.new_block();
+            let latch = m.new_block();
+            let exit = m.new_block();
+            m.br(header);
+            m.set_block(header);
+            let counter = m.phi(ty);
+            let left = m.phi(ty);
+            let right = m.phi(ty);
+            let chain: Vec<_> = (0..64).map(|_| m.phi(ty)).collect();
+            let cond = m.cmp(Pred::Ne, counter, zero);
+            m.cond_br(cond, latch, exit);
+            m.set_block(latch);
+            let dec = m.bin(BinOp::Sub, counter, one);
+            m.br(header);
+            m.set_block(exit);
+            let call = m.call(sink, &[chain[0], left]);
+            m.ret();
+            for (phi, start, next) in [(counter, two, dec), (left, seed, right), (right, different, left)] {
+                m.add_incoming(phi, start, Block(0));
+                m.add_incoming(phi, next, latch);
+            }
+            for (i, &phi) in chain.iter().enumerate() {
+                m.add_incoming(phi, seed, Block(0));
+                m.add_incoming(phi, chain.get(i + 1).copied().unwrap_or(tail), latch);
+            }
+            m.optimize();
+            assert_eq!(m.block_insts(header).len(), 5, "three phis, compare and branch");
+            let Value::Inst(call) = call else { unreachable!() };
+            let mut operands = Vec::new();
+            m.insts[call as usize].op.for_each_operand(|v| operands.push(v));
+            assert_eq!(operands, [seed, left]);
+            assert!(m.try_to_bitcode("dxil-ms-dx", "").is_ok());
+        }
+    }
+}
