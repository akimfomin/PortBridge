+const NO_WATCH: usize = usize::MAX;
+
+#[derive(Clone, Copy)]
+struct PhiWatch {
+    input: usize,
+    previous: usize,
+    next: usize,
+}
+
+/// Each phi has two reserved watch slots. The lists index those slots so
+/// retargeting a watch needs no per-edge allocation or search.
+struct PhiWaiters {
+    first: Vec<usize>,
+    slots: Vec<PhiWatch>,
+}
+
+impl PhiWaiters {
+    fn new(insts: usize, phis: usize) -> Self {
+        let empty = PhiWatch { input: NO_WATCH, previous: NO_WATCH, next: NO_WATCH };
+        Self { first: vec![NO_WATCH; insts], slots: vec![empty; 2 * phis] }
+    }
+
+    fn link(&mut self, slot: usize, input: usize) {
+        debug_assert_eq!(self.slots[slot].input, NO_WATCH);
+        let next = self.first[input];
+        self.slots[slot] = PhiWatch { input, previous: NO_WATCH, next };
+        if next != NO_WATCH {
+            self.slots[next].previous = slot;
+        }
+        self.first[input] = slot;
+    }
+
+    fn unlink(&mut self, slot: usize) {
+        let PhiWatch { input, previous, next } = self.slots[slot];
+        if input == NO_WATCH {
+            return;
+        }
+        if previous == NO_WATCH {
+            self.first[input] = next;
+        } else {
+            self.slots[previous].next = next;
+        }
+        if next != NO_WATCH {
+            self.slots[next].previous = previous;
+        }
+        self.slots[slot].input = NO_WATCH;
+    }
+
+    fn take_user(&mut self, input: usize) -> Option<usize> {
+        let slot = self.first[input];
+        if slot == NO_WATCH {
+            return None;
+        }
+        // A scheduled phi has no active watches until it is evaluated again.
+        self.unlink(slot);
+        self.unlink(slot ^ 1);
+        Some(slot / 2)
+    }
+}
+
+/// A single non-self input, or two different inputs that keep the phi live.
+fn phi_value(repl: &mut [Option<Value>], i: u32, incoming: &[(Value, super::Block)]) -> Result<Option<Value>, [Value; 2]> {
+    let mut same = None;
+    for &(input, _) in incoming {
+        let value = resolve(repl, input);
+        if value == Value::Inst(i) || Some(value) == same {
+            continue;
+        }
+        if let Some(other) = same {
+            return Err([other, value]);
+        }
+        same = Some(value);
+    }
+    Ok(same)
+}
