+    /// Collapse trivial phis in block order, then revisit only phis whose inputs change.
+    fn simplify_phis(&self, order: &[u32], repl: &mut [Option<Value>]) {
+        let phis = || {
+            order.iter().flat_map(|&b| {
+                self.blocks[b as usize].iter().copied()
+                    .take_while(|&i| matches!(self.insts[i as usize].op, Op::Phi(_)))
+            })
+        };
+        // Small cascades can finish before building the dependency table.
+        for _ in 0..2 {
+            let mut saw_conflict = false;
+            let mut revisit = false;
+            for &b in order {
+                for &i in &self.blocks[b as usize] {
+                    if repl[i as usize].is_some() {
+                        continue;
+                    }
+                    let Op::Phi(incoming) = &self.insts[i as usize].op else { break };
+                    match phi_value(repl, i, incoming) {
+                        Ok(Some(v)) => {
+                            repl[i as usize] = Some(v);
+                            revisit |= saw_conflict;
+                        }
+                        Ok(None) => {}
+                        Err(_) => saw_conflict = true,
+                    }
+                }
+            }
+            if !revisit {
+                return;
+            }
+        }
+
+        // Keep the scan order within each logical round so cycles choose the same
+        // representatives. A changed input only schedules affected phis.
+        let candidates: Vec<_> = phis().filter(|&i| repl[i as usize].is_none()).collect();
+        let mut initial = 0..candidates.len();
+        let mut ready = BinaryHeap::new();
+        let mut waiters = PhiWaiters::new(self.insts.len(), candidates.len());
+        // The first sweep only wakes already visited ranks, all for round one.
+        while let Some(Reverse((round, rank))) = initial.next().map(|rank| Reverse((0, rank))).or_else(|| ready.pop()) {
+            let i = candidates[rank];
+            let Op::Phi(incoming) = &self.insts[i as usize].op else { unreachable!() };
+            match phi_value(repl, i, incoming) {
+                Ok(Some(v)) => {
+                    repl[i as usize] = Some(v);
+                    while let Some(user) = waiters.take_user(i as usize) {
+                        ready.push(Reverse((round + usize::from(user < rank), user)));
+                    }
+                }
+                Ok(None) => {}
+                Err(conflict) => {
+                    // Two different non-self inputs are enough to rule out a
+                    // replacement. Either must change before this phi can fold.
+                    for (slot, input) in conflict.into_iter().enumerate() {
+                        if let Value::Inst(j) = input {
+                            if matches!(self.insts[j as usize].op, Op::Phi(_)) {
+                                waiters.link(2 * rank + slot, j as usize);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
