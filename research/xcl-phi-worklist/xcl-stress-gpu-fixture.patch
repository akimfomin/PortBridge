 /// Hand the wave64 mirror program to the CreateComputePipelineState hook, dispatch the
 /// pipeline it built and check every thread's output.
 fn mirror_program_through_the_hook(dev: &ID3D12Device) {
+    let Some(count) = std::env::var("PORTBRIDGE_RND_PSO_LOOPS").ok().and_then(|v| v.parse::<usize>().ok()) else {
+        return mirror_program_with_code(dev, &program());
+    };
+    assert!((1..=128).contains(&count));
+    let mut code = Vec::new();
+    let mut emit = |name, enc, fields: &[(&str, u64)]| {
+        code.extend(encode(name, enc, fields, None).expect(name));
+    };
+    for reg in 4..100 {
+        emit("S_MOV_B32", "ENC_SOP1", &[("SDST", reg), ("SSRC0", 151)]);
+    }
+    for _ in 0..count {
+        emit("S_MOV_B32", "ENC_SOP1", &[("SDST", 100), ("SSRC0", 130)]);
+        for reg in 4..99 {
+            emit("S_MOV_B32", "ENC_SOP1", &[("SDST", reg), ("SSRC0", reg + 1)]);
+        }
+        emit("S_MOV_B32", "ENC_SOP1", &[("SDST", 99), ("SSRC0", 151)]);
+        emit("S_SUB_U32", "ENC_SOP2", &[("SDST", 100), ("SSRC0", 100), ("SSRC1", 129)]);
+        emit("S_CMP_LG_U32", "ENC_SOPC", &[("SSRC0", 100), ("SSRC1", 128)]);
+        emit("S_CBRANCH_SCC1", "ENC_SOPP", &[("SIMM16", 0x10000 - 99)]);
+    }
+    code.extend(program());
+    mirror_program_with_code(dev, &code);
+    let route = xcl::gpu::dxil::coverage::fallback_summary();
+    assert!(route.contains("CS direct 1 / HLSL fallback 0;"), "{route}");
+    println!("{route}");
+    println!("verified readback: 1536 dwords (loops={count})");
+}
