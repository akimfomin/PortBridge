diff --git a/tests/test_rdna2_fma_rounding.py b/tests/test_rdna2_fma_rounding.py
new file mode 100644
index 0000000..01d53f4
--- /dev/null
+++ b/tests/test_rdna2_fma_rounding.py
@@ -0,0 +1,30 @@
+"""Arrondi unique des FMA f32, y compris lorsque la somme double tombe à mi-chemin."""
+
+import pytest
+
+from emu import rdna2_exec
+from test_rdna2_exec import V, program, vop2, vop3
+from test_rdna2_exec_vop12 import mov
+
+
+@pytest.mark.parametrize("a,b,c,expected", [
+    (0x3FC0_0000, 0x3F80_0001, 0x9980_0000, 0x3FC0_0001),
+    (0x3FC0_0000, 0x3F80_0003, 0x1980_0000, 0x3FC0_0005),
+    (0xBFC0_0000, 0x3F80_0001, 0x1980_0000, 0xBFC0_0001),
+    (0x3FC0_0000, 0x3F80_0001, 0x0000_0000, 0x3FC0_0002),
+])
+def test_fma_f32_rounds_the_exact_sum(a, b, c, expected):
+    # 1,5 × (1 + 2^-23) = 1,5 + 3 × 2^-24, au milieu de deux f32.
+    # L'addition de ±2^-76 déplace la somme exacte de part et d'autre de ce milieu.
+    wave = rdna2_exec.run(program(
+        *mov(1, a), *mov(2, b), *mov(3, c),
+        *mov(4, c), vop2("v_fmac_f32", 4, V + 1, 2),
+        *mov(5, c), *vop3("v_fmac_f32", 5, V + 1, V + 2),
+        *mov(6, c), vop2("v_fmac_legacy_f32", 6, V + 1, 2),
+        *mov(7, c), *vop3("v_fmac_legacy_f32", 7, V + 1, V + 2),
+        *vop3("v_fma_f32", 8, V + 1, V + 2, V + 3),
+        vop2("v_fmamk_f32", 9, V + 1, 3), b,
+        vop2("v_fmaak_f32", 10, V + 1, 2), c,
+        *vop3("v_fma_legacy_f32", 11, V + 1, V + 2, V + 3),
+    ))
+    assert [wave.v[reg] for reg in range(4, 12)] == [[expected] * 32] * 8
