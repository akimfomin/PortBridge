+def _fma(a, b, c):
+    """Prépare l'arrondi unique d'un produit-somme de trois entrées f32."""
+    product = a * b                        # au plus 48 bits significatifs, exact en f64
+    total = product + c
+    if not total or not math.isfinite(total) or not product or not c:
+        return total
+    mantissa, exponent = math.frexp(abs(total))
+    # La demi-ULP est 2^(exponent-25), avec un minimum de 2^-150.
+    if exponent > 128 or math.ldexp(mantissa, min(25, exponent + 150)) % 2 != 1:
+        return total
+    # Au milieu de deux f32, FastTwoSum retrouve le signe de l'erreur de la somme f64.
+    if abs(product) < abs(c):
+        product, c = c, product
+    error = c - (total - product)
+    if not error:
+        return total
+    return math.nextafter(total, math.copysign(math.inf, error))
+
