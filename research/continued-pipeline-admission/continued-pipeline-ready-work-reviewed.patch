+static int deferred_modules_leave_workers_for_small_jobs() {
+    LargeModuleGate gate(10, 2);
+    leonida::LargeModuleWorkQueue work(gate, 5);
+    auto first = work.take();
+    CHECK(first && first->index == 0 && !first->ticket);
+    CHECK(work.admit_or_defer(*first, 9));
+    CHECK(first->ticket && gate.inflight() == 1);
+    for (std::size_t index : {1u, 2u}) {
+        auto large = work.take();
+        CHECK(large && large->index == index && !large->ticket);
+        CHECK(!work.admit_or_defer(*large, 6));
+    }
+    auto small = work.take();
+    CHECK(small && small->index == 3 && !small->ticket && gate.inflight() == 1);
+    CHECK(work.admit_or_defer(*small, 0));
+
+    first->ticket.release();
+    auto oldest = work.take();
+    CHECK(oldest && oldest->index == 1 && oldest->ticket && oldest->estimate == 6);
+    small = work.take();
+    CHECK(small && small->index == 4 && !small->ticket && gate.inflight() == 1);
+    // This fresh job would fit alongside the first, but must not jump the already deferred job.
+    CHECK(!work.admit_or_defer(*small, 3));
+    oldest->ticket.release();
+
+    auto last = work.take();
+    CHECK(last && last->index == 2 && last->ticket && last->estimate == 6);
+    auto follower = work.take();
+    CHECK(follower && follower->index == 4 && follower->ticket && follower->estimate == 3);
+    last->ticket.release();
+    follower->ticket.release();
+    CHECK(!work.take());
+    CHECK(gate.inflight() == 0);
+    return 0;
+}
+
+static int changed_estimate_releases_and_defers_again() {
+    LargeModuleGate gate(10, 3);
+    leonida::LargeModuleWorkQueue work(gate, 3);
+    auto holder = LargeModuleGate::Ticket::try_acquire(gate, 7);
+    auto first = work.take();
+    CHECK(first && first->index == 0 && !work.admit_or_defer(*first, 6));
+    auto second = work.take();
+    CHECK(second && second->index == 1 && !work.admit_or_defer(*second, 5));
+    holder.release();
+    holder = LargeModuleGate::Ticket::try_acquire(gate, 3);
+    CHECK(holder);
+    auto grown = work.take();
+    CHECK(grown && grown->index == 0 && grown->ticket && grown->estimate == 6);
+    CHECK(!work.admit_or_defer(*grown, 8));
+    CHECK(!grown->ticket && gate.inflight() == 1);
+    auto next = work.take();
+    CHECK(next && next->index == 1 && next->ticket);
+    auto small = work.take();
+    CHECK(small && small->index == 2 && work.admit_or_defer(*small, 0));
+    next->ticket.release();
+    holder.release();
+    grown = work.take();
+    CHECK(grown && grown->index == 0 && grown->ticket && grown->estimate == 8);
+    CHECK(work.admit_or_defer(*grown, 0));  // a later retry sees the same file shrink to a small module
+    CHECK(!grown->ticket && gate.inflight() == 0);
+    CHECK(!work.take());
+    return 0;
+}
