+// Workers classify each new item after opening it. If a large item cannot enter, leave it here and
+// take further work. The oldest deferred module gets first claim on a permit when it fits.
+class LargeModuleWorkQueue {
+public:
+    struct Claim {
+        std::size_t index;
+        uint64_t estimate = 0;
+        LargeModuleGate::Ticket ticket{};
+    };
+
+    LargeModuleWorkQueue(LargeModuleGate& gate, std::size_t size) : gate_(gate), size_(size) {}
+
+    bool admit_or_defer(Claim& claim, uint64_t estimate) {
+        if (claim.estimate != estimate) claim.ticket.release();  // the file size may change after deferral
+        claim.estimate = estimate;
+        if (!estimate || claim.ticket) return true;
+        std::lock_guard<std::mutex> lock(mu_);
+        if (deferred_.empty()) claim.ticket = LargeModuleGate::Ticket::try_acquire(gate_, estimate);
+        if (claim.ticket) return true;
+        deferred_.emplace_back(claim.index, estimate);
+        return false;
+    }
+
+    std::optional<Claim> take() {
+        std::lock_guard<std::mutex> lock(mu_);
+        if (!deferred_.empty()) {
+            const auto [index, estimate] = deferred_.front();
+            auto ticket = LargeModuleGate::Ticket::try_acquire(gate_, estimate);
+            if (ticket) {
+                deferred_.pop_front();
+                return Claim{index, estimate, std::move(ticket)};
+            }
+        }
+        if (next_ < size_) return Claim{next_++};
+        if (deferred_.empty()) return std::nullopt;
+        const auto [index, estimate] = deferred_.front();
+        // All fresh items have been claimed. Keep this turn with the head until its permit is available.
+        // Permit release takes only the gate lock, and a worker releases its claim before taking the next.
+        LargeModuleGate::Ticket ticket(gate_, estimate);
+        deferred_.pop_front();
+        return Claim{index, estimate, std::move(ticket)};
+    }
+
+private:
+    LargeModuleGate& gate_;
+    const std::size_t size_;
+    std::size_t next_ = 0;
+    std::mutex mu_;
+    std::deque<std::pair<std::size_t, uint64_t>> deferred_;
+};
+
 }  // namespace leonida
