+fn present_plane_srv_format(format: DXGI_FORMAT) -> DXGI_FORMAT {
+    // Swap-chain storage formats are not necessarily legal typed SRVs.
+    // D3D12 forbids FLOAT/non-FLOAT and SNORM/UNORM casts on these resources.
+    match format {
+        DXGI_FORMAT_R16G16B16A16_UNORM
+        | DXGI_FORMAT_R16G16B16A16_SNORM
+        | DXGI_FORMAT_R8G8B8A8_SNORM => format,
+        _ => swap_format(format).unwrap_or(format),
+    }
+}
