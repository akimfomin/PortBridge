+    /// Braun et al. (CC 2013), §3.2: a PHI cycle with one external value is
+    /// redundant. Here we handle only i32 rings in a header with an entry
+    /// edge and a self-latch. Those edges and an entry-body seed establish
+    /// dominance without another control-flow analysis.
+    fn fold_entry_seeded_phi_rings(&self, reachable: &[bool], repl: &mut [Option<V>]) {
+        let Some(entry) = self.blocks.first() else {
+            return;
+        };
+        let entry_edges = successors(entry.term);
+        if !entry_edges
+            .iter()
+            .any(|&head| head != 0 && self.blocks[head].phis.len() >= 2)
+        {
+            return;
+        }
+        let entry_values: HashSet<_> = entry.body.iter().copied().collect();
+        for &header in entry_edges.iter() {
+            let block = &self.blocks[header];
+            if header == 0 || block.phis.len() < 2 {
+                continue;
+            }
+            let count_edges = |from: usize| {
+                successors(self.blocks[from].term)
+                    .iter()
+                    .filter(|&&to| to == header)
+                    .count()
+            };
+            if count_edges(0) != 1
+                || count_edges(header) != 1
+                || reachable.iter().enumerate().any(|(from, &live)| {
+                    live && from != 0 && from != header && count_edges(from) != 0
+                })
+            {
+                continue;
+            }
+            let mut links = HashMap::new();
+            for &i in &block.phis {
+                let inst = &self.insts[i as usize];
+                if repl[i as usize].is_some() || self.int_bits(inst.ty) != Some(32) {
+                    continue;
+                }
+                let Op::Phi(incoming) = &inst.op else {
+                    continue;
+                };
+                let (seed, back) = match incoming.as_slice() {
+                    &[(seed, 0), (back, pred)] | &[(back, pred), (seed, 0)] if pred == header => {
+                        (seed, back)
+                    }
+                    _ => continue,
+                };
+                let V::Inst(next) = resolve(repl, back) else {
+                    continue;
+                };
+                let seed = resolve(repl, seed);
+                let seed_ty = match seed {
+                    V::Const(c) => self.consts.get(c as usize).and_then(|(ty, constant)| {
+                        matches!(constant, Const::Int(_)).then_some(*ty)
+                    }),
+                    V::Inst(s) if entry_values.contains(&s) => Some(self.insts[s as usize].ty),
+                    _ => None,
+                };
+                if seed_ty == Some(inst.ty) {
+                    links.insert(i, (next, seed));
+                }
+            }
+            // Each candidate has one back operand, so following the links either
+            // reaches a previously walked path or closes one ring of this path.
+            let mut indices = HashMap::new();
+            let mut path = Vec::new();
+            for &start in links.keys() {
+                let path_start = path.len();
+                let mut node = start;
+                while let Some(&(next, seed)) = links.get(&node) {
+                    match indices.entry(node) {
+                        Entry::Occupied(first) => {
+                            let first = *first.get();
+                            if first >= path_start
+                                && path.len() - first >= 2
+                                && path[first..].iter().all(|member| links[member].1 == seed)
+                            {
+                                for &member in &path[first..] {
+                                    repl[member as usize] = Some(seed);
+                                }
+                            }
+                            break;
+                        }
+                        Entry::Vacant(position) => {
+                            position.insert(path.len());
+                            path.push(node);
+                            node = next;
+                        }
+                    }
+                }
+            }
+        }
+    }
