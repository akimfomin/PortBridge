+    #[test]
+    fn entry_seeded_phi_rings_require_a_single_available_seed_and_exact_edges() {
+        for case in ["constant", "entry", "two", "none", "non-entry", "extra-pred", "duplicate"] {
+            let mut m = Module::default();
+            let (entry, header, exit) = (m.new_block(), m.new_block(), m.new_block());
+            let ty = m.int(32);
+            let a = m.i32(7);
+            let b = m.i32(13);
+            let take_back = m.bool(true);
+            let entry_value = m.bin(entry, Bin::Add, a, b);
+            let p = m.phi(header, ty);
+            let q = m.phi(header, ty);
+            let non_entry = m.bin(header, Bin::Add, a, b);
+            m.terminate(entry, Term::Br(header));
+            m.terminate(header, Term::CondBr(take_back, header, exit));
+            m.terminate(exit, if case == "extra-pred" { Term::Br(header) } else { Term::Ret });
+            let (source, other) = match case {
+                "entry" => (entry_value, entry_value),
+                "two" => (a, b),
+                "none" => (q, p),
+                "non-entry" => (non_entry, non_entry),
+                _ => (a, a),
+            };
+            m.set_phi(p, vec![(source, entry), (q, header)]);
+            let other_edge = if case == "duplicate" { header } else { entry };
+            m.set_phi(q, vec![(p, header), (other, other_edge)]);
+            let mut repl = vec![None; m.insts.len()];
+            m.fold_entry_seeded_phi_rings(&m.reachable_blocks(), &mut repl);
+            let expected = matches!(case, "constant" | "entry").then_some(source);
+            for member in [p, q] {
+                let V::Inst(i) = member else { unreachable!() };
+                assert_eq!(repl[i as usize], expected, "{case}");
+            }
+        }
+    }
 }
