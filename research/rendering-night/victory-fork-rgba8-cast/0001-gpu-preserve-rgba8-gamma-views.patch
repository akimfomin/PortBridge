+/// Whether the host device allows fully typed casts within a format family.
+/// Copied descriptors all use the process's single host device.
+fn supports_typed_format_casting(device: &ID3D12Device) -> bool {
+    static SUPPORTED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *SUPPORTED.get_or_init(|| {
+        let mut options = D3D12_FEATURE_DATA_D3D12_OPTIONS3::default();
+        // SAFETY: a feature query into our own structure of the requested type.
+        let queried = unsafe {
+            device.CheckFeatureSupport(
+                D3D12_FEATURE_D3D12_OPTIONS3,
+                (&raw mut options).cast(),
+                size_of_val(&options) as u32,
+            )
+        };
+        queried.is_ok() && options.CastingFullyTypedFormatSupported.as_bool()
+    })
+}
