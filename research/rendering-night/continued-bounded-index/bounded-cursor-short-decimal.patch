diff --git a/runtime/src/shader_library.h b/runtime/src/shader_library.h
index 9f9112f..74d9d38 100644
--- a/runtime/src/shader_library.h
+++ b/runtime/src/shader_library.h
@@ -633,8 +633,20 @@ private:
         }
         if (token.empty()) return false;
         out.kind = Json::Kind::number;
-        char* end = nullptr;
         errno = 0;
+        // An unsigned decimal of at most 15 digits is exactly representable in binary64.
+        // Apply the fast path to the complete token, including any bytes from a refill.
+        if (token.size() <= 15) {
+            std::uint64_t integer = 0;
+            auto digit = token.begin();
+            for (; digit != token.end() && *digit >= '0' && *digit <= '9'; ++digit)
+                integer = integer * 10 + std::uint64_t(*digit - '0');
+            if (digit == token.end()) {
+                out.number = double(integer);
+                return true;
+            }
+        }
+        char* end = nullptr;
         out.number = std::strtod(token.c_str(), &end);
         return errno != ERANGE && end == token.c_str() + token.size();
     }
