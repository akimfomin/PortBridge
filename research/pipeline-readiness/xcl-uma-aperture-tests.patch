+//! Differential GPU and native pipeline checks for proved pixel apertures.
+use super::kernel::{translate_pixel, translate_pixel_for_uma_aperture, KernelOptions};
+use crate::gpu::dxbc::SigElement;
+use crate::gpu::rdna2::encode;
+use crate::gpu::recomp::{dxc, runner, PsInterface, HEAP_WINDOWS, IO_UMA_BASE_HI};
+use windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT_R32G32_FLOAT;
+
+fn emit(code: &mut Vec<u8>, name: &str, enc: &str, fields: &[(&str, u64)]) {
+    code.extend(encode(name, enc, fields, None).unwrap_or_else(|e| panic!("{name}: {e}")));
+}
+
+fn carry_shader(offset: u64) -> (Vec<u8>, PsInterface) {
+    let mut code = Vec::new();
+    emit(&mut code, "V_MOV_B32", "ENC_VOP1", &[("VDST", 20), ("SRC0", 0)]);
+    emit(&mut code, "V_MOV_B32", "ENC_VOP1", &[("VDST", 21), ("SRC0", 128)]);
+    emit(&mut code, "S_MOV_B32", "ENC_SOP1", &[("SDST", 126), ("SSRC0", 6)]);
+    emit(&mut code, "GLOBAL_LOAD_DWORD", "ENC_FLAT_GLBL", &[("VDST", 4), ("ADDR", 20), ("SADDR", 0x7D), ("OFFSET", offset)]);
+    emit(&mut code, "EXP", "ENC_EXP", &[("TGT", 0), ("EN", 15), ("VSRC0", 4), ("VSRC1", 4), ("VSRC2", 4), ("VSRC3", 4), ("DONE", 1), ("VM", 1)]);
+    emit(&mut code, "S_ENDPGM", "ENC_SOPP", &[]);
+    let sig = |name: &str, system_value| SigElement {
+        name: name.into(), index: 0, system_value, component_type: 3, register: 0,
+        mask: 15, rw_mask: 15, stream: 0,
+    };
+    (code, PsInterface {
+        inputs: vec![sig("SV_Position", 1)], outputs: vec![sig("SV_Target", 64)],
+        input_ena: 0x2, attrs: None,
+    })
+}
+
+#[test]
+fn aperture_carry_and_borrow_preserve_window_and_exec() {
+    if !super::graphics::tests::draw_ready() || dxc::location().is_err() {
+        return runner::skip_test("no graphics adapter or DXC");
+    }
+    let root = std::env::var("XCL_APERTURE_TEST_ROOT").as_deref() != Ok("0");
+    let opt = KernelOptions { wave64: false, split: false, mem_windows: if root { 4 } else { 4 | HEAP_WINDOWS }, sampler_base: 0 };
+    let vs = dxc::compile("float4 main(float2 p: POSITION): SV_Position {return float4(p, 0, 1);}", "main", "vs_6_6", &[]).unwrap();
+    let verts = [-1.0, -1.0, -1.0, 3.0, 3.0, -1.0];
+    let layout = [runner::VertexElement { semantic: "POSITION", index: 0, format: DXGI_FORMAT_R32G32_FLOAT, offset: 0 }];
+    let mut mem = vec![9.0f32.to_bits(); 256];
+    mem[0] = 3.0f32.to_bits();
+    mem[7] = 4.0f32.to_bits();
+    mem[12] = 5.0f32.to_bits();
+    let clear = [8.0; 4];
+    if let Ok(arm) = std::env::var("XCL_APERTURE_DRAW_ARM") {
+        let (code, abi) = carry_shader(16);
+        let shader = match arm.as_str() {
+            "off" => translate_pixel(&code, opt, &abi),
+            "on" => translate_pixel_for_uma_aperture(&code, opt, &abi, 4),
+            _ => panic!("XCL_APERTURE_DRAW_ARM must be off or on"),
+        }.unwrap().dxil;
+        super::validate::validate(&shader).unwrap();
+        let mut sgprs = [0; IO_UMA_BASE_HI + 1];
+        sgprs[0] = 32;
+        sgprs[6] = u32::MAX;
+        sgprs[IO_UMA_BASE_HI] = 4;
+        let pixels = runner::draw_heap_windows(&vs, &shader, &layout, &verts, 8, &sgprs, &mem, 64, 128, clear).unwrap();
+        assert_eq!(pixels, vec![[5.0; 4]; 128 * 128]);
+        println!("aperture ready draw {arm}: {} correct pixels", pixels.len());
+        return;
+    }
+    for (offset, edge_low, normal) in [(16, 0xffff_fff0, 5.0), (0xffc, 0, 4.0)] {
+        let (code, abi) = carry_shader(offset);
+        let baseline = translate_pixel(&code, opt, &abi).unwrap().dxil;
+        let specialized = translate_pixel_for_uma_aperture(&code, opt, &abi, 4).unwrap().dxil;
+        assert_ne!(baseline, specialized);
+        for unsafe_base in [0, 1, u32::MAX - 3] {
+            let generic = translate_pixel_for_uma_aperture(&code, opt, &abi, unsafe_base).unwrap().dxil;
+            assert_eq!(baseline, generic, "unsafe aperture {unsafe_base:#x} must keep generic DXIL");
+        }
+        for shader in [&baseline, &specialized] {
+            super::validate::validate(shader).unwrap();
+        }
+        let count_switches = |shader: &[u8]| super::validate::disassemble(shader).unwrap().matches("switch i32").count();
+        if root {
+            assert_eq!((count_switches(&baseline), count_switches(&specialized)), (1, 0));
+        }
+        for (low, exec, wanted) in [(32, u32::MAX, [normal; 4]), (edge_low, u32::MAX, [0.0; 4]), (32, 0, clear)] {
+            let mut sgprs = [0; IO_UMA_BASE_HI + 1];
+            sgprs[0] = low;
+            sgprs[6] = exec;
+            sgprs[IO_UMA_BASE_HI] = 4;
+            for shader in [&baseline, &specialized] {
+                let pixels = runner::draw_heap_windows(&vs, shader, &layout, &verts, 8, &sgprs, &mem, 64, 8, clear).unwrap();
+                assert_eq!(pixels, vec![wanted; 64], "offset {offset:#x}, low {low:#x}, exec {exec:#x}");
+            }
+        }
+        if offset == 16 {
+            let mut sgprs = [0; IO_UMA_BASE_HI + 1];
+            sgprs[0] = edge_low;
+            sgprs[6] = u32::MAX;
+            sgprs[IO_UMA_BASE_HI] = 1;
+            let fallback = translate_pixel_for_uma_aperture(&code, opt, &abi, 1).unwrap().dxil;
+            let pixels = runner::draw_heap_windows(&vs, &fallback, &layout, &verts, 8, &sgprs, &mem, 64, 8, clear).unwrap();
+            assert_eq!(pixels, vec![[3.0; 4]; 64], "carry into high one is valid for the uncertified base");
+        }
+    }
+    println!("{}: 832 RGBA32F pixels matched CPU carry, borrow, EXEC and uncertified-base cases",
+        runner::adapter().unwrap());
+}
+
+#[test]
+fn aperture_open_pixel_pso() {
+    let Some(path) = std::env::var_os("XCL_APERTURE_SAMPLE_PS") else { return };
+    let varyings: u32 = std::env::var("XCL_APERTURE_SAMPLE_VARYINGS").unwrap().parse().unwrap();
+    assert!(varyings <= 16);
+    let mut vs = String::from("struct V { float4 p: SV_Position;\n");
+    for n in 0..varyings {
+        vs.push_str(&format!("float4 p{n}: TEXCOORD{n};\n"));
+    }
+    vs.push_str("}; V main(uint id:SV_VertexID) {V a=(V)0; a.p=float4(0,0,0,1); return a;}");
+    let vs = dxc::compile(&vs, "main", "vs_6_6", &[]).unwrap();
+    let ps = std::fs::read(path).unwrap();
+    super::validate::validate(&ps).expect("open shader DXIL validates");
+    runner::disable_driver_shader_cache().expect("D3D12 accepted implicit cache disable");
+    let (native_ms, cache_bytes) = runner::measure_aperture_pixel_pso(&vs, &ps).unwrap();
+    println!("aperture sample adapter={} native_ms={native_ms:.6} opaque_cache_bytes={cache_bytes} dxil_bytes={}",
+        runner::adapter().unwrap(), ps.len());
+}
