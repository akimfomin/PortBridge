+    /// Return the incoming i1 when this i32 is a widened one-bit carry or
+    /// borrow. The subtraction form is the direct address lowering's borrow.
+    pub(super) fn unit_high_nonzero(&self, value: Value) -> Option<Value> {
+        let Value::Inst(i) = value else { return None };
+        if self.int_width(self.insts[i as usize].ty) != Some(32) {
+            return None;
+        }
+        let op = match &self.insts[i as usize].op {
+            Op::Bin(BinOp::Sub, zero, Value::Inst(j), 0) if self.const_u64(*zero) == Some(0) => {
+                &self.insts[*j as usize].op
+            }
+            other => other,
+        };
+        match op {
+            Op::Cast(CastOp::ZExt | CastOp::SExt, bit, _) if self.int_width(self.value_ty(*bit)) == Some(1) => Some(*bit),
+            _ => None,
+        }
+    }
+
+    /// Recognize a selected window that is either window zero or invalid.
+    pub(super) fn window_zero_condition(&self, value: Value, windows: u32) -> Option<Value> {
+        let Value::Inst(i) = value else { return None };
+        let Op::Select(cond, yes, no) = self.insts[i as usize].op else { return None };
+        (self.const_u64(yes) == Some(0) && self.const_u64(no).is_some_and(|v| v >= u64::from(windows)))
+            .then_some(cond)
+    }
