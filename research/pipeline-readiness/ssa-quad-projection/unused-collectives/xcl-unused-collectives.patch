+    /// Remove unobserved pixel ballot results only when a used ballot witnesses WaveOps.
+    /// Preserve the CFG and the order of all remaining instructions. A call can converge
+    /// differently when moved or merged; this sweep only erases an unobserved result.
+    pub(in crate::gpu::dxil) fn prune_pixel_collectives(&mut self, include_quad_reads: bool) -> bool {
+        use super::{MdDef, TypeDef};
+
+        let order: Vec<u32> = self.block_layout().0.into_iter().map(|b| b as u32).collect();
+        if !self.uses_well_formed(&order) {
+            return false;
+        }
+        let mut ballots = vec![false; self.insts.len()];
+        let mut quads = vec![false; self.insts.len()];
+        for &b in &order {
+            for &i in &self.blocks[b as usize] {
+                let Op::Call(f, args) = &self.insts[i as usize].op else { continue };
+                let decl = &self.funcs[*f as usize];
+                if decl.attrs != FnAttrs::NoUnwind {
+                    continue;
+                }
+                let opcode = args.first().and_then(|&v| self.const_u64(v));
+                let integer = |ty: Ty, width| matches!(self.types[ty.0 as usize], TypeDef::Int(w) if w == width);
+                let ret = self.insts[i as usize].ty;
+                match (decl.name.as_str(), opcode, args.as_slice()) {
+                    ("dx.op.waveActiveBallot", Some(116), [op, cond])
+                        if integer(self.value_ty(*op), 32) && integer(self.value_ty(*cond), 1)
+                            && matches!(&self.types[ret.0 as usize], TypeDef::Struct(Some(n), fields)
+                                if n == "dx.types.fouri32" && fields.len() == 4 && fields.iter().all(|&t| integer(t, 32))) =>
+                    {
+                        ballots[i as usize] = true;
+                    }
+                    (name, Some(code), [op, value, lane])
+                        if include_quad_reads && integer(ret, 32) && integer(self.value_ty(*op), 32)
+                            && integer(self.value_ty(*value), 32) &&
+                            ((name == "dx.op.quadReadLaneAt.i32" && code == 122 && integer(self.value_ty(*lane), 32))
+                                || (name == "dx.op.quadOp.i32" && code == 123 && integer(self.value_ty(*lane), 8)
+                                    && matches!(self.const_u64(*lane), Some(0..=2)))) =>
+                    {
+                        quads[i as usize] = true;
+                    }
+                    _ => {}
+                }
+            }
+        }
+        if !ballots.contains(&true) {
+            return false;
+        }
+        let narrow_int = |ty: Ty| matches!(self.types[ty.0 as usize], TypeDef::Int(1 | 32));
+        let mut live = vec![false; self.insts.len()];
+        let mut stack = Vec::new();
+        for &b in &order {
+            for &i in &self.blocks[b as usize] {
+                let inst = &self.insts[i as usize];
+                if ballots[i as usize] || quads[i as usize] {
+                    continue;
+                }
+                // No other calls, loads, casts from wide values, FP ops or derivatives
+                // are candidates. Integer feeders may become dead after ballot removal.
+                let pure = match &inst.op {
+                    Op::Extract(Value::Inst(src), idx) => *idx < 4 && ballots[*src as usize],
+                    Op::Bin(..) | Op::Cmp(..) | Op::Cast(..) | Op::Select(..) | Op::Phi(_) => {
+                        let mut narrow = narrow_int(inst.ty);
+                        inst.op.for_each_operand(|v| narrow &= narrow_int(self.value_ty(v)));
+                        narrow
+                    }
+                    _ => false,
+                };
+                if !pure {
+                    stack.push(i);
+                }
+            }
+        }
+        for md in &self.md {
+            if let MdDef::Val(_, Value::Inst(i)) = md {
+                stack.push(*i);
+            }
+        }
+        while let Some(i) = stack.pop() {
+            if std::mem::replace(&mut live[i as usize], true) {
+                continue;
+            }
+            self.insts[i as usize].op.for_each_operand(|v| {
+                if let Value::Inst(id) = v {
+                    stack.push(id);
+                }
+            });
+        }
+        if !ballots.iter().zip(&live).any(|(&ballot, &used)| ballot && used)
+            || !(0..live.len()).any(|i| !live[i] && (ballots[i] || quads[i]))
+        {
+            return false;
+        }
+        for b in order {
+            self.blocks[b as usize].retain(|&i| live[i as usize]);
+        }
+        true
+    }
+
     /// Whether every non-phi operand of the reachable instructions is written before its
     /// use and has a value (what the writer checks).
     fn uses_well_formed(&self, order: &[u32]) -> bool {
@@ -1129,6 +1226,64 @@ mod tests {
             .count()
     }
 
+    #[test]
+    fn pixel_sweep_preserves_an_observed_ballot_and_every_other_call_in_order() {
+        use crate::gpu::dxil::shader::Shader;
+        use crate::gpu::dxil::container::Stage;
+        let mut sh = Shader::new(Stage::Pixel, (6, 6));
+        let i32t = sh.m.i32();
+        let i1 = sh.m.i1c(true);
+        let x = sh.wave_ballot(i1)[0];
+        let opcode = sh.m.i32c(77);
+        let sink_ty = sh.m.func_ty(i32t, &[i32t, i32t]);
+        let sink = sh.m.declare("test.external.observer", sink_ty, FnAttrs::NoUnwind);
+        sh.m.call(sink, &[opcode, x]);
+        let lane = sh.m.i32c(2);
+        let _ = sh.quad_read_lane_at(x, lane);
+        let float = sh.m.f32c(0);
+        let derivative = sh.deriv(crate::gpu::dxil::ops::Deriv::FineX, float);
+        sh.barrier(8);
+        let unused = sh.wave_ballot(i1)[0];
+        let _ = sh.m.bin(BinOp::And, unused, x);
+        sh.m.ret();
+        let before = sh.m.blocks.clone();
+        assert!(sh.m.prune_pixel_collectives(false));
+        let ballot_only = sh.m.blocks.clone();
+        assert!(sh.m.prune_pixel_collectives(true));
+        let after = &sh.m.blocks;
+        assert_eq!(before.len(), after.len());
+        assert!(after[0].len() < ballot_only[0].len());
+        assert!(after[0].windows(2).all(|w| w[0] < w[1]));
+        assert_eq!(count_calls(&sh.m, sink), 1);
+        let Value::Inst(derivative) = derivative else { panic!("expected a derivative call") };
+        assert!(after[0].contains(&derivative));
+        let taken: Vec<_> = after[0].iter().filter_map(|&i| {
+            if let Op::Call(f, _) = &sh.m.insts[i as usize].op {
+                Some(sh.m.funcs[*f as usize].name.as_str())
+            } else { None }
+        }).collect();
+        assert_eq!(taken, ["dx.op.waveActiveBallot", "test.external.observer", "dx.op.unary.f32", "dx.op.barrier"]);
+        assert!(!sh.m.prune_pixel_collectives(true));
+    }
+
+    #[test]
+    fn pixel_sweep_falls_back_when_only_dead_ballots_or_unreachable_anchors_exist() {
+        use crate::gpu::dxil::shader::Shader;
+        use crate::gpu::dxil::container::Stage;
+        let mut sh = Shader::new(Stage::Pixel, (6, 6));
+        let i1 = sh.m.i1c(true);
+        let _ = sh.wave_ballot(i1);
+        sh.m.ret();
+        let b = sh.m.new_block();
+        sh.m.set_block(b);
+        let word = sh.wave_ballot(i1)[0];
+        let _ = sh.m.md_value(word);
+        sh.m.ret();
+        let before = sh.m.blocks.clone();
+        assert!(!sh.m.prune_pixel_collectives(true));
+        assert_eq!(sh.m.blocks, before);
+    }
+
