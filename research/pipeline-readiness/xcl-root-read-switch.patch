+#[test]
+fn graphics_read_switches_merge_only_identical_window_selectors() {
+    use crate::gpu::recomp::{dxc, runner};
+    if dxc::location().is_err() {
+        return runner::skip_test("no DXC");
+    }
+    let mut switches = Vec::new();
+    let mut reads = Vec::new();
+    for shared_high in [true, false] {
+        let dxil = read_guards_pixel(shared_high, 4, 1, 1, false);
+        super::validate::validate(&dxil).expect("root-window read shader validates");
+        let disassembly = super::validate::disassemble(&dxil).unwrap();
+        let body = disassembly.split("define void @main()").nth(1).and_then(|s| s.split("\n}\n").next())
+            .expect("main body");
+        switches.push(body.matches("switch i32").count());
+        reads.push(body.matches("call %dx.types.ResRet.i32 @dx.op.rawBufferLoad.i32").count());
+    }
+    let disabled = std::env::var("XCL_DXIL_NO_OPT").unwrap_or_default();
+    let switch_fusion = std::env::var("XCL_DXIL_SWITCH_READ_FUSION").as_deref() == Ok("1")
+        && !disabled.split(',').any(|pass| matches!(pass.trim(), "read-switches" | "cse" | "all"));
+    if switch_fusion {
+        assert!(switches[0] < switches[1], "only identical root-window selectors can fuse: {switches:?}");
+    } else {
+        assert_eq!(switches[0], switches[1], "without switch fusion both shaders retain their dispatches");
+    }
+    assert_eq!(reads[0] + 3, reads[1], "four per-window load sites per read plus differently used SGPRs");
+    println!("root switches with same and changed selectors: {switches:?}; raw reads: {reads:?}");
+}
