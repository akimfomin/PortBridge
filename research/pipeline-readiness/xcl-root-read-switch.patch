+                SwitchControl::DifferentSelector,
+                SwitchControl::DifferentKey,
+                SwitchControl::ReorderedKeys,
+                SwitchControl::EffectInArm,
+                SwitchControl::EffectInMiddle,
+                SwitchControl::DependentAddress,
+                SwitchControl::DependentJoinValue,
+            ] {
+                let mut m = generate_switch_pair(&mut rng, arms, control);
