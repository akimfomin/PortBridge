index 0000000..8bf6940
--- /dev/null
+++ b/crates/xcl/src/gpu/dxil/module/guard_switch.rs
@@ -0,0 +1,162 @@
+//! Fuse consecutive root-UAV read switches with identical selectors and cases.
+
+use std::collections::{HashMap, HashSet};
+
+use super::{Block, Module, Op, Value};
+
+impl Module {
+    pub(in super::super) fn fuse_read_switches(&mut self, order: &[u32]) -> bool {
+        let mut incoming = vec![0; self.blocks.len()];
+        for &source in order {
+            for target in self.successors(source as usize) {
+                incoming[target.0 as usize] += 1;
+            }
+        }
+
+        let mut changed = false;
+        for &source in order {
+            // A fused region contains at most eight original read switches.
+            for _ in 1..8 {
+                if !self.fuse_read_switch_pair(Block(source), &incoming) {
+                    break;
+                }
+                changed = true;
+            }
+        }
+        changed
+    }
+
+    fn fuse_read_switch_pair(&mut self, source: Block, incoming: &[usize]) -> bool {
+        let Some(head) = self.last_inst(source) else { return false };
+        let Op::Switch(selector, middle, first_cases) = &self.insts[head].op else { return false };
+        let middle = *middle;
+        let Some(middle_end) = self.last_inst(middle) else { return false };
+        let Op::Switch(again, join, second_cases) = &self.insts[middle_end].op else { return false };
+        let join = *join;
+        let arm_count = first_cases.len();
+        if selector != again || !(2..=4).contains(&arm_count) || arm_count != second_cases.len()
+            || incoming[middle.0 as usize] != arm_count + 1
+            || incoming[join.0 as usize] != arm_count + 1
+        {
+            return false;
+        }
+        let arms: Option<Vec<_>> = first_cases.iter().zip(second_cases).map(|(&(key, first), &(again, second))| {
+            (key == again).then_some((first, second))
+        }).collect();
+        let Some(arms) = arms else { return false };
+        let mut distinct = HashSet::from([source, middle, join]);
+        if distinct.len() != 3 || !arms.iter().all(|&(first, second)| {
+            distinct.insert(first) && distinct.insert(second)
+                && self.is_read_switch_arm(first, middle, incoming)
+                && self.is_read_switch_arm(second, join, incoming)
+        }) {
+            return false;
+        }
+
+        // Row zero in the PHI mappings is the default edge. Each subsequent
+        // row maps the same switch key from the first region to the second.
+        let first_preds: Vec<_> = std::iter::once(source).chain(arms.iter().map(|&(first, _)| first)).collect();
+        let second_preds: Vec<_> = std::iter::once(middle).chain(arms.iter().map(|&(_, second)| second)).collect();
+        let mid = &self.blocks[middle.0 as usize];
+        let mut mid_inputs = HashMap::new();
+        for &i in mid {
+            let Op::Phi(inputs) = &self.insts[i as usize].op else { break };
+            let Some(mapped) = switch_phi_inputs(inputs, &first_preds) else { return false };
+            mid_inputs.insert(Value::Inst(i), mapped);
+        }
+
+        // Results derived from a middle PHI can move after the join PHIs only
+        // if no second arm or incoming join PHI value needs them.
+        let mut sinks = HashSet::new();
+        for &i in &mid[mid_inputs.len()..mid.len() - 1] {
+            if !self.guard_math(i) {
+                return false;
+            }
+            let mut depends_on_phi = false;
+            self.insts[i as usize].op.for_each_operand(|v| {
+                depends_on_phi |= mid_inputs.contains_key(&v) || sinks.contains(&v);
+            });
+            if depends_on_phi {
+                sinks.insert(Value::Inst(i));
+            }
+        }
+        for &(_, second) in &arms {
+            for &i in &self.blocks[second.0 as usize] {
+                let mut uses_sink = false;
+                self.insts[i as usize].op.for_each_operand(|v| uses_sink |= sinks.contains(&v));
+                if uses_sink {
+                    return false;
+                }
+            }
+        }
+
+        let mut join_phis = Vec::new();
+        for &i in &self.blocks[join.0 as usize] {
+            let Op::Phi(inputs) = &self.insts[i as usize].op else { break };
+            let Some(mapped) = switch_phi_inputs(inputs, &second_preds) else { return false };
+            if mapped.iter().any(|v| sinks.contains(v)) {
+                return false;
+            }
+            let rewritten = mapped.into_iter().zip(&first_preds).enumerate()
+                .map(|(row, (v, &label))| (mid_inputs.get(&v).map_or(v, |values| values[row]), label))
+                .collect();
+            join_phis.push((i, rewritten));
+        }
+
+        let mut middle_phis = std::mem::take(&mut self.blocks[middle.0 as usize]);
+        middle_phis.pop();
+        let source_body = &mut self.blocks[source.0 as usize];
+        source_body.pop();
+        let mut sink_insts = Vec::new();
+        for i in middle_phis.drain(mid_inputs.len()..) {
+            if sinks.contains(&Value::Inst(i)) {
+                self.def_block[i as usize] = join;
+                sink_insts.push(i);
+            } else {
+                self.def_block[i as usize] = source;
+                source_body.push(i);
+            }
+        }
+        let Op::Switch(_, default, _) = &mut self.insts[head].op else { unreachable!() };
+        *default = join;
+        source_body.push(head as u32);
+
+        for (arm, &(first, second)) in arms.iter().enumerate() {
+            let second_body = std::mem::take(&mut self.blocks[second.0 as usize]);
+            let first_body = &mut self.blocks[first.0 as usize];
+            first_body.pop();
+            for i in second_body {
+                self.insts[i as usize].op.map_operands(|v| mid_inputs.get(&v).map_or(v, |values| values[arm + 1]));
+                self.def_block[i as usize] = first;
+                first_body.push(i);
+            }
+        }
+
+        let join_phi_count = join_phis.len();
+        for (i, rewritten) in join_phis {
+            self.insts[i as usize].op = Op::Phi(rewritten);
+        }
+        for &i in &middle_phis {
+            self.def_block[i as usize] = join;
+        }
+        let join_body = &mut self.blocks[join.0 as usize];
+        join_body.splice(join_phi_count..join_phi_count, sink_insts);
+        join_body.splice(..0, middle_phis);
+        true
+    }
+
+    fn is_read_switch_arm(&self, arm: Block, join: Block, incoming: &[usize]) -> bool {
+        incoming[arm.0 as usize] == 1
+            && self.last_inst(arm).is_some_and(|i| matches!(self.insts[i].op, Op::Br(b) if b == join))
+            && self.readonly_arm(arm)
+    }
+}
+
+fn switch_phi_inputs(inputs: &[(Value, Block)], labels: &[Block]) -> Option<Vec<Value>> {
+    if inputs.len() != labels.len() {
+        return None;
+    }
+    labels.iter().map(|label| {
+        inputs.iter().find_map(|&(value, block)| (block == *label).then_some(value))
+    }).collect()
+}
