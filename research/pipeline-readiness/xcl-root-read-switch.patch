+#[derive(Clone, Copy, Debug)]
+enum SwitchControl {
+    Fuse,
+    DifferentSelector,
+    DifferentKey,
+    ReorderedKeys,
+    EffectInArm,
+    EffectInMiddle,
+    DependentAddress,
+    DependentJoinValue,
