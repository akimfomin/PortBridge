+//! Differential tests for the read-guard CFG rewrite on a small integer IR subset.
+//! Calls stand in for deterministic memory and declared observable operations.
+
+use std::collections::BTreeMap;
+
+use super::*;
+
+#[derive(Clone, Copy, Debug)]
+enum Control {
+    Fusible,
+    ChangePredicate,
+    ExtraPredecessor,
+    UseDependentAddress,
+    UseDependentJoinValue,
+    Wave,
+    Derivative,
+    Store,
+    Atomic,
+    Barrier,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum Event {
+    Read(u32, u32),
+    Effect(u32),
+    Output(u32),
+}
+
+struct Random(u32);
+
+impl Random {
+    fn next(&mut self) -> u32 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 17;
+        self.0 ^= self.0 << 5;
+        self.0
+    }
+}
+
+fn add_phi(m: &mut Module, rng: &mut Random, a: (Value, Block), b: (Value, Block)) -> Value {
+    let i32 = m.i32();
+    let phi = m.phi(i32);
+    let entries = if rng.next() & 1 == 0 { [a, b] } else { [b, a] };
+    for (value, label) in entries {
+        m.add_incoming(phi, value, label);
+    }
+    phi
+}
+
+fn random_math(m: &mut Module, rng: &mut Random, value: Value) -> Value {
+    let ops = [BinOp::Add, BinOp::Sub, BinOp::And, BinOp::Or, BinOp::Xor];
+    let op = ops[rng.next() as usize % ops.len()];
+    let rhs = m.i32c(rng.next());
+    m.bin(op, value, rhs)
+}
+
+fn generate(rng: &mut Random, control: Control) -> Module {
+    let mut m = Module::new();
+    m.define_entry("main");
+    let i32 = m.i32();
+    let input_ty = m.func_ty(i32, &[]);
+    let unary_ty = m.func_ty(i32, &[i32]);
+    let binary_ty = m.func_ty(i32, &[i32, i32]);
+    let input = m.declare("cfg_test_input", input_ty, FnAttrs::ReadNone);
+    let output = m.declare("cfg_test_output", unary_ty, FnAttrs::NoUnwind);
+    let read = m.declare("dx.op.rawBufferLoad.i32", binary_ty, FnAttrs::ReadOnly);
+    let effect = match control {
+        Control::Wave => Some(("dx.op.waveReadLaneFirst.i32", FnAttrs::NoUnwind)),
+        Control::Derivative => Some(("dx.op.derivCoarseX.f32", FnAttrs::ReadNone)),
+        Control::Store => Some(("dx.op.rawBufferStore.i32", FnAttrs::NoUnwind)),
+        Control::Atomic => Some(("dx.op.atomicBinOp.i32", FnAttrs::NoUnwind)),
+        Control::Barrier => Some(("dx.op.barrier", FnAttrs::NoDuplicate)),
+        _ => None,
+    };
+    let effect = effect.map(|(name, attrs)| m.declare(name, unary_ty, attrs));
+
+    // Exercise predecessor labels independently of physical block and PHI order.
+    let mut blocks: Vec<_> = (0..9).map(|_| m.new_block()).collect();
+    for i in (1..blocks.len()).rev() {
+        blocks.swap(i, rng.next() as usize % (i + 1));
+    }
+    let [prelude, source, first, middle, second, join, then, otherwise, exit] =
+        <[Block; 9]>::try_from(blocks).unwrap();
+
+    let zero = m.i32c(0);
+    let bit = m.i32c(1);
+    let mask = m.i32c(255);
+    let lower_limit = m.i32c(1 + rng.next() % 254);
+    let upper_limit = m.i32c(255);
+    let win_a = m.i32c(rng.next() & 15);
+    let win_b = m.i32c(rng.next() & 15);
+    let entry = m.entry_block();
+    let input = m.call(input, &[]);
+    let lsb = m.bin(BinOp::And, input, bit);
+    let shortcut = m.cmp(Pred::Eq, lsb, zero);
+    let sample = m.bin(BinOp::And, input, mask);
+    let condition = m.cmp(Pred::ULt, sample, lower_limit);
+    let alternate = m.cmp(Pred::ULt, sample, upper_limit);
+    m.cond_br(shortcut, source, prelude);
+
+    m.set_block(prelude);
+    let adjusted = random_math(&mut m, rng, input);
+    let extra_predecessor = matches!(control, Control::ExtraPredecessor);
+    if extra_predecessor {
+        m.cond_br(condition, first, source);
+    } else {
+        m.br(source);
+    }
+
+    m.set_block(source);
+    let address = add_phi(&mut m, rng, (input, entry), (adjusted, prelude));
+    m.cond_br(condition, first, middle);
+    m.set_block(first);
+    let guard_input = if extra_predecessor { input } else { address };
+    let read_a = m.call(read, &[win_a, guard_input]);
+    let read_a = random_math(&mut m, rng, read_a);
+    m.br(middle);
+
+    m.set_block(middle);
+    let running = add_phi(&mut m, rng, (address, source), (read_a, first));
+    let window = add_phi(&mut m, rng, (win_a, source), (win_b, first));
+    let independent = random_math(&mut m, rng, guard_input);
+    let masked = m.select(condition, running, independent);
+    let sank = random_math(&mut m, rng, masked);
+    let second_cond = if matches!(control, Control::ChangePredicate) { alternate } else { condition };
+    m.cond_br(second_cond, second, join);
+
+    m.set_block(second);
+    let address = if matches!(control, Control::UseDependentAddress) { sank } else { independent };
+    let read_b = m.call(read, &[window, address]);
+    if let Some(effect) = effect {
+        m.call(effect, &[read_b]);
+    }
+    let result = m.bin(BinOp::Xor, running, read_b);
+    m.br(join);
+
+    m.set_block(join);
+    let skipped = if matches!(control, Control::UseDependentJoinValue) { sank } else { running };
+    let joined = add_phi(&mut m, rng, (skipped, middle), (result, second));
+    let joined = m.bin(BinOp::Xor, joined, sank);
+    m.cond_br(shortcut, then, otherwise);
+
+    m.set_block(then);
+    let left = random_math(&mut m, rng, joined);
+    m.br(exit);
+    m.set_block(otherwise);
+    let right = random_math(&mut m, rng, joined);
+    m.br(exit);
+    m.set_block(exit);
+    let result = add_phi(&mut m, rng, (left, then), (right, otherwise));
+    m.call(output, &[result]);
+    m.ret();
+    m
+}
+
+fn interpret(m: &Module, input: u32) -> Vec<Event> {
+    let mut events = Vec::new();
+    let mut results = BTreeMap::new();
+    let mut block = m.entry_block();
+    let mut predecessor = None;
+
+    for _ in 0..m.blocks.len() {
+        let mut next = None;
+        for &id in &m.blocks[block.0 as usize] {
+            let value = |arg: Value| match arg {
+                Value::Inst(i) => results[&i],
+                Value::Const(_) => m.const_u64(arg).unwrap() as u32,
+                _ => panic!("unexpected value: {arg:?}"),
+            };
+            let result = match &m.insts[id as usize].op {
+                Op::Bin(op, a, b, 0) => {
+                    let (a, b) = (value(*a), value(*b));
+                    match op {
+                        BinOp::Add => a.wrapping_add(b),
+                        BinOp::Sub => a.wrapping_sub(b),
+                        BinOp::And => a & b,
+                        BinOp::Or => a | b,
+                        BinOp::Xor => a ^ b,
+                        _ => panic!("unexpected binary op: {op:?}"),
+                    }
+                }
+                Op::Cmp(Pred::Eq, a, b) => u32::from(value(*a) == value(*b)),
+                Op::Cmp(Pred::ULt, a, b) => u32::from(value(*a) < value(*b)),
+                Op::Select(c, a, b) => if value(*c) == 0 { value(*b) } else { value(*a) },
+                Op::Phi(inputs) => {
+                    let incoming = inputs.iter().filter(|(_, label)| Some(*label) == predecessor);
+                    assert_eq!(incoming.clone().count(), 1, "invalid PHI on executed edge");
+                    value(incoming.map(|(value, _)| *value).next().unwrap())
+                }
+                Op::Call(f, args) => match m.funcs[*f as usize].name.as_str() {
+                    "cfg_test_input" => input,
+                    "cfg_test_output" => {
+                        events.push(Event::Output(value(args[0])));
+                        0
+                    }
+                    "dx.op.rawBufferLoad.i32" => {
+                        let (window, address) = (value(args[0]), value(args[1]));
+                        events.push(Event::Read(window, address));
+                        address.wrapping_mul(0x9e37_79b9).rotate_left(window)
+                    }
+                    _ => {
+                        events.push(Event::Effect(*f));
+                        value(args[0])
+                    }
+                },
+                Op::Br(target) => {
+                    next = Some(*target);
+                    break;
+                }
+                Op::CondBr(c, yes, no) => {
+                    next = Some(if value(*c) == 0 { *no } else { *yes });
+                    break;
+                }
+                Op::Ret => return events,
+                op => panic!("unexpected instruction: {op:?}"),
+            };
+            assert!(results.insert(id, result).is_none(), "generated CFG must be acyclic");
+        }
+        predecessor = Some(block);
+        block = next.expect("every generated block must be terminated");
+    }
+    panic!("generated CFG did not return");
+}
+
+#[test]
+fn generated_read_guard_cfgs_preserve_reads_and_outputs() {
+    for seed in 1..=32 {
+        let mut rng = Random(0x9e37_79b9 ^ seed);
+        for control in [
+            Control::Fusible,
+            Control::ChangePredicate,
+            Control::ExtraPredecessor,
+            Control::UseDependentAddress,
+            Control::UseDependentJoinValue,
+            Control::Wave,
+            Control::Derivative,
+            Control::Store,
+            Control::Atomic,
+            Control::Barrier,
+        ] {
+            let mut m = generate(&mut rng, control);
+            let input: Vec<_> = (0..=255).map(|low| rng.next() & !255 | low).collect();
+            let before: Vec<_> = input.iter().map(|&x| interpret(&m, x)).collect();
+            let order: Vec<_> = m.block_layout().0.into_iter().map(|b| b as u32).collect();
+            let changed = m.fuse_read_guards(&order);
+            assert_eq!(changed, matches!(control, Control::Fusible), "seed={seed} {control:?}");
+            assert_eq!(m.block_layout().0.len(), order.len() - 2 * usize::from(changed));
+            for (&input, expected) in input.iter().zip(before) {
+                assert_eq!(interpret(&m, input), expected, "seed={seed} {control:?} {input:#x}");
+            }
+        }
+    }
+}
