+fn read_guards_pixel(shared_high: bool, mem_windows: u32, groups: usize) -> Vec<u8> {
+    use crate::gpu::recomp::PsInterface;
+    let mut code = Vec::new();
+    let mut emit = |name, encoding, fields: &[(&str, u64)], literal| {
+        code.extend(encode(name, encoding, fields, literal).unwrap_or_else(|error| panic!("{name}: {error}")));
+    };
+    // Different aligned low addresses. SADDR is off and OFFSET is zero, so
+    // their upper dwords are identical at the actual memory selection.
+    for i in 0..4 {
+        let high_sgpr = if shared_high { 1 } else { 1 + i };
+        emit("V_MOV_B32", "ENC_VOP1", &[("VDST", 21 + 2 * i), ("SRC0", high_sgpr)], None);
+    }
+    emit("S_MOV_B32", "ENC_SOP1", &[("SDST", 126), ("SSRC0", 6)], None);
+    for group in 0..groups {
+        for i in 0..4 {
+            let off = 64 + 16 * group as u32 + 4 * i as u32;
+            emit("V_MOV_B32", "ENC_VOP1", &[("VDST", 20 + 2 * i), ("SRC0", 255)], Some(off));
+        }
+        let dest = if group == 0 { 4 } else { 8 };
+        for i in 0..4 {
+            emit("GLOBAL_LOAD_DWORD", "ENC_FLAT_GLBL", &[("VDST", dest + i), ("ADDR", 20 + 2 * i), ("SADDR", 0x7D), ("OFFSET", 0)], None);
+        }
+        if group != 0 {
+            for i in 0..4 {
+                emit("V_ADD_F32", "ENC_VOP2", &[("VDST", 4 + i), ("SRC0", 256 + dest + i), ("VSRC1", 4 + i)], None);
+            }
+        }
+    }
+    emit("EXP", "ENC_EXP", &[("TGT", 0), ("EN", 0xF), ("VSRC0", 4), ("VSRC1", 5), ("VSRC2", 6), ("VSRC3", 7), ("DONE", 1), ("VM", 1)], None);
+    emit("S_ENDPGM", "ENC_SOPP", &[], None);
+    let psi = PsInterface {
+        inputs: vec![sig("SV_Position", 0, 1, 3, 0, 0xF)],
+        outputs: vec![sig("SV_Target", 0, 64, 3, 0, 0xF)],
+        input_ena: 0x2,
+        attrs: None,
+    };
+    super::kernel::translate_pixel(&code, KernelOptions { wave64: false, split: false, mem_windows, sampler_base: 0 }, &psi)
+        .expect("read guard pixel shader translates")
+        .dxil
+}
