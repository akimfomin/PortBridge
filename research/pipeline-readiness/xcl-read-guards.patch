+#[test]
+fn graphics_read_guards_merge_only_equal_window_conditions() {
+    use crate::gpu::recomp::{dxc, runner, HEAP_WINDOWS};
+    if dxc::location().is_err() {
+        return runner::skip_test("no DXC");
+    }
+    let mut branches = Vec::new();
+    for shared_high in [true, false] {
+        let dxil = read_guards_pixel(shared_high, HEAP_WINDOWS | 4, 1);
+        super::validate::validate(&dxil).expect("read guard pixel shader validates");
+        let disassembly = super::validate::disassemble(&dxil).unwrap();
+        let body = disassembly.split("define void @main()").nth(1).and_then(|s| s.split("\n}\n").next()).expect("main body");
+        let mut heap_handles = std::collections::HashSet::new();
+        let mut annotated_heap = std::collections::HashSet::new();
+        let mut reads = 0;
+        for line in body.lines() {
+            let Some((result, op)) = line.trim().split_once(" = ") else { continue };
+            if op.contains("@dx.op.createHandleFromHeap(") {
+                heap_handles.insert(result);
+            } else if let Some((_, operand)) = op.split_once("@dx.op.annotateHandle(i32 216, %dx.types.Handle ") {
+                if operand.split(',').next().is_some_and(|handle| heap_handles.contains(handle)) {
+                    annotated_heap.insert(result);
+                }
+            } else if let Some((_, operand)) = op.split_once("@dx.op.rawBufferLoad.i32(i32 139, %dx.types.Handle ") {
+                reads += usize::from(operand.split(',').next().is_some_and(|handle| annotated_heap.contains(handle)));
+            }
+        }
+        assert_eq!(reads, 4, "all four distinct heap reads must survive");
+        branches.push(body.matches("br i1").count());
+    }
+    let disabled = std::env::var("XCL_DXIL_NO_OPT").unwrap_or_default();
+    if disabled.split(',').any(|pass| matches!(pass.trim(), "read-guards" | "cse" | "all")) {
+        assert_eq!(branches[0], branches[1], "without equivalent-guard fusion both shaders retain every guard");
+    } else {
+        assert!(branches[0] < branches[1], "only identical window predicates can fuse: {branches:?}");
+    }
+    println!("same-window and changed-window conditional branches: {branches:?}");
+}
