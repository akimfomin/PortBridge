+#[test]
+fn graphics_read_guards_match_cpu_pixels() {
+    use crate::gpu::recomp::{dxc, runner, HEAP_WINDOWS, IO_UMA_BASE_HI};
+    use windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT_R32G32_FLOAT;
+    if !super::graphics::tests::draw_ready() {
+        return;
+    }
+    if dxc::location().is_err() {
+        return runner::skip_test("no DXC");
+    }
+    if std::env::var("XCL_READ_GUARD_TEST_COLD").as_deref() == Ok("1") {
+        runner::disable_driver_shader_cache().expect("D3D12 accepted the cache-disable request");
+        println!("guard fixture implicit shader cache disable accepted");
+    }
+    let vs = dxc::compile(
+        "float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }",
+        "main", "vs_6_6", &[],
+    ).unwrap();
+    let layout = [runner::VertexElement { semantic: "POSITION", index: 0, format: DXGI_FORMAT_R32G32_FLOAT, offset: 0 }];
+    let vertices = [-1.0f32, -1.0, -1.0, 3.0, 3.0, -1.0];
+    let mut sgprs = [0; IO_UMA_BASE_HI + 1];
+    let expected = [0.25f32, 0.5, 0.75, 1.0];
+    let mut mem = vec![0x3f80_0000; 24];
+    for (slot, value) in mem[16..20].iter_mut().zip(expected) {
+        *slot = value.to_bits();
+    }
+    let clear = [9.0; 4];
+    let ps = read_guards_pixel(true, 1, 1);
+    super::validate::validate(&ps).expect("root read guard pixel shader validates");
+    for (mask, wanted) in [(u32::MAX, expected), (0, clear)] {
+        sgprs[6] = mask;
+        let pixels = runner::draw(&vs, &ps, &layout, &vertices, 8, &sgprs, &mem, 8, clear).unwrap();
+        assert_eq!(pixels, vec![wanted; 64], "all 64 pixels for EXEC mask {mask:#x}");
+    }
+
+    let colors = [
+        [0.125f32, 0.25, 0.375, 0.5],
+        [0.75, 0.875, 1.0, 1.125],
+        [1.25, 1.375, 1.5, 1.625],
+        [1.75, 1.875, 2.0, 2.125],
+    ];
+    let groups = std::env::var("XCL_READ_GUARD_TEST_GROUPS").ok().map_or(1, |v|
+        v.parse::<usize>().ok().filter(|n| (1..=512).contains(n)).expect("XCL_READ_GUARD_TEST_GROUPS must be 1–512"));
+    let window_words = (16 + groups * 4).next_multiple_of(64);
+    let mut mem = vec![0x4080_0000; window_words * colors.len()];
+    for (window, color) in colors.iter().enumerate() {
+        for group in 0..groups {
+            for (i, value) in color.iter().enumerate() {
+                mem[window * window_words + 16 + group * 4 + i] = value.to_bits();
+            }
+        }
+    }
+    let before_translation = std::time::Instant::now();
+    let ps = read_guards_pixel(true, HEAP_WINDOWS | 4, groups);
+    let translate_ms = before_translation.elapsed().as_secs_f64() * 1000.0;
+    assert!(ps.len() <= 320 * 1024, "unbounded graphics fixture");
+    let bytecode = crate::gpu::shader::fnv64(&ps);
+    super::validate::validate(&ps).expect("heap read guard pixel shader validates");
+    let repeats = std::env::var("XCL_READ_GUARD_TEST_REPEATS").ok().map_or(1, |v|
+        v.parse::<usize>().ok().filter(|n| (1..=4).contains(n)).expect("XCL_READ_GUARD_TEST_REPEATS must be 1–4"));
+    let base = 0x400;
+    sgprs[IO_UMA_BASE_HI] = base;
+    sgprs[6] = u32::MAX;
+    let cases = [(0, colors[0]), (base + 1, colors[1]), (base + 3, colors[3]), (base + 4, [0.0; 4])];
+    let measured = if std::env::var("XCL_READ_GUARD_TEST_FIRST_ONLY").as_deref() == Ok("1") {
+        &cases[..1]
+    } else {
+        &cases
+    };
+    for repetition in 0..repeats {
+        for &(high, wanted) in measured {
+            sgprs[1] = high;
+            let wanted = wanted.map(|color| color * groups as f32);
+            let started = std::time::Instant::now();
+            let pixels = runner::draw_heap_windows(&vs, &ps, &layout, &vertices, 8, &sgprs, &mem, window_words, 8, clear).unwrap();
+            let readback_ms = started.elapsed().as_secs_f64() * 1000.0;
+            assert_eq!(pixels, vec![wanted; 64], "all 64 pixels for high address {high:#x}");
+            println!("guard fixture groups={groups} repetition={repetition} high={high:#x} bytes={} bytecode_fnv64={bytecode:016x} translate_ms={translate_ms:.3} create_draw_readback_ms={readback_ms:.3} pixel={wanted:?}", ps.len());
+        }
+    }
+    println!("{}: {} RGBA32F pixels match the CPU controls", runner::adapter().unwrap(),
+             128 + 64 * measured.len() * repeats);
+}
