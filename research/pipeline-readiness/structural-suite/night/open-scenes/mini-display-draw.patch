+// Use the same texture, topology, constants, viewport, target and readback for a
+// translated PAL shader and the unmodified MiniEngine HLSL with its own PresentRS.
+#[test]
+fn open_miniengine_display_draw() {
+    use crate::gpu::desc;
+    use std::io::Write;
+    use windows::Win32::Graphics::Direct3D12::*;
+    use windows::Win32::Graphics::Dxgi::Common::*;
+
+    let Some(input_path) = std::env::var_os("PB_INPUT_RGBA32F") else {
+        println!("SKIPPED: MiniEngine display fixture absent");
+        return;
+    };
+
+    let value = |name| std::env::var(name).unwrap_or_else(|_| panic!("missing {name}"));
+    let (width, height) = (value("PB_SCENE_SIZE").parse::<u32>().unwrap(), value("PB_SCENE_HEIGHT").parse::<u32>().unwrap());
+    let (tw, th) = (value("PB_TEXTURE_WIDTH").parse::<u32>().unwrap(), value("PB_TEXTURE_HEIGHT").parse::<u32>().unwrap());
+    assert!((4..=1280).contains(&width) && (4..=720).contains(&height));
+    assert!((4..=1280).contains(&tw) && (4..=720).contains(&th));
+    let kind = value("PB_MINI_KIND");
+    assert!(matches!(kind.as_str(), "present" | "bilinear" | "bicubic" | "sharpen"));
+    let data = std::fs::read(input_path).unwrap();
+    assert_eq!(data.len(), (tw * th * 16) as usize);
+    assert!(data.chunks_exact(4).all(|s| f32::from_le_bytes(s.try_into().unwrap()).is_finite()));
+    let tex_format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+    let res = D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_TEXTURE2D, Width: tw as u64, Height: th,
+        DepthOrArraySize: 1, MipLevels: 1, Format: tex_format,
+        SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 }, ..Default::default()
+    };
+    let mut srv = D3D12_SHADER_RESOURCE_VIEW_DESC {
+        Format: tex_format, ViewDimension: D3D12_SRV_DIMENSION_TEXTURE2D,
+        Shader4ComponentMapping: D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING, ..Default::default()
+    };
+    srv.Anonymous.Texture2D = D3D12_TEX2D_SRV { MipLevels: 1, ..Default::default() };
+    let tex = runner::ViewTexture { res, srv, data, row_bytes: tw as usize * 16 };
+    let mut sgprs = [0u32; crate::gpu::recomp::KERNEL_SGPRS];
+    let mut mem = [0u32; 1024];
+    let table = 16usize;
+    let cb = 128usize;
+    sgprs[1] = (4 * table) as u32;
+    sgprs[IO_UMA_BASE_HI] = 4;
+    let constants = std::fs::read(value("PB_PRESENT_CONSTANTS")).unwrap();
+    assert_eq!(constants.len(), 24);
+    for (i, bytes) in constants.chunks_exact(4).enumerate() {
+        let word = u32::from_le_bytes(bytes.try_into().unwrap());
+        mem[cb + i] = word;
+        sgprs[120 + i] = word;
+    }
+    let format = desc::gfx10_format(tex_format).unwrap();
+    mem[table..table + 8].copy_from_slice(&desc::xcl_image_for_view(0, format, desc::ImageType::D2, tw, th, 1, 1));
+    // These offsets are verified from AMD's PAL pipeline document before launch.
+    let sampler_offset: i32 = value("PB_SAMPLER_OFFSET").parse().unwrap();
+    let cb_offset: i32 = value("PB_CBV_OFFSET").parse().unwrap();
+    let s = [2 | (2 << 3) | (2 << 6), 0xFFF << 12, (1 << 20) | (1 << 22) | (2 << 26), 0];
+    if sampler_offset >= 0 {
+        assert!((8..=48).contains(&sampler_offset));
+        let j = table + sampler_offset as usize;
+        mem[j..j + 4].copy_from_slice(&desc::xcl_sampler_words(&s, 0));
+    }
+    if cb_offset >= 0 {
+        assert!((8..=48).contains(&cb_offset));
+        let j = table + cb_offset as usize;
+        mem[j..j + 4].copy_from_slice(&desc::cbv_words((4u64 << 32) + (cb * 4) as u64, 32));
+    }
+    let ps = std::fs::read(value("PB_SCENE_PS")).unwrap();
+    super::validate::validate(&ps).unwrap();
+    let present_root = std::env::var_os("PB_MINI_NATIVE_ROOT").map(|p| std::fs::read(p).unwrap());
+    let vs = dxc::compile(r#"
+        struct Output { float4 p:SV_Position; float4 uv:TEXCOORD0; };
+        Output main(uint id:SV_VertexID) {
+            float2 pos = id == 0 ? float2(-1,-1) : id == 1 ? float2(-1,3) : float2(3,-1);
+            Output result;
+            result.p = float4(pos,0,1);
+            result.uv = float4(pos*float2(0.5,-0.5)+0.5,0,1);
+            return result;
+        }"#, "main", "vs_6_6", &[]).unwrap();
+    let clear = [-3.0; 4];
+    runner::disable_driver_shader_cache().unwrap();
+    let started = std::time::Instant::now();
+    let pixels = runner::draw_gs_views(&vs, None, &ps, &[], &[0.0; 6], 8, &[], &sgprs, &mem,
+        &[tex], &[desc::sampler_d3d12(&s, false)], (width,height), clear, Some(256), present_root.as_deref()).unwrap();
+    println!("scene_native_setup_submit_readback_ms={:.4}", started.elapsed().as_secs_f64()*1000.0);
+    assert_eq!(pixels.len(), (width*height) as usize);
+    assert!(!pixels.iter().any(|p| p[..3] == clear[..3]));
+    let mut file = std::io::BufWriter::new(std::fs::OpenOptions::new().write(true).create_new(true).open(value("PB_SCENE_IMAGE")).unwrap());
+    for pixel in pixels {
+        for ch in pixel { file.write_all(&ch.to_le_bytes()).unwrap(); }
+    }
+    file.flush().unwrap();
+    println!("display adapter={} size={}x{} kind={}",runner::adapter().unwrap(),width,height,kind);
+}
