+// Corpus receipt: render an external DXV-validated pixel shader using registered
+// PAL scalar words and two interpolated texture coordinates on a full triangle.
+#[test]
+fn open_procedural_pixel_draw() {
+    use std::io::Write;
+    let Some(sgpr_path) = std::env::var_os("PB_SCENE_SGPRS") else {
+        println!("SKIPPED: open scene fixture absent");
+        return;
+    };
+    let ps_path = std::env::var_os("PB_SCENE_PS").expect("PB_SCENE_PS");
+    let image_path = std::env::var_os("PB_SCENE_IMAGE").expect("PB_SCENE_IMAGE");
+    let size: u32 = std::env::var("PB_SCENE_SIZE").expect("PB_SCENE_SIZE").parse().unwrap();
+    let height: u32 = std::env::var("PB_SCENE_HEIGHT").unwrap_or_else(|_| size.to_string()).parse().unwrap();
+    assert!((4..=1280).contains(&size) && (4..=720).contains(&height));
+    let scalar_file = std::fs::read(sgpr_path).unwrap();
+    assert_eq!(scalar_file.len(), crate::gpu::recomp::KERNEL_SGPRS * 4);
+    let sgprs: Vec<u32> = scalar_file.chunks_exact(4)
+        .map(|value| u32::from_le_bytes(value.try_into().unwrap())).collect();
+    assert_eq!(sgprs[IO_UMA_BASE_HI], 4);
+    let ps = std::fs::read(ps_path).unwrap();
+    super::validate::validate(&ps).expect("pixel shader must validate");
+    let vs = dxc::compile(r#"
+        struct V { float4 p: SV_Position; float4 uv: TEXCOORD0; };
+        V main(float2 pos: POSITION) {
+            V v;
+            v.p = float4(pos, 0, 1);
+            v.uv = float4(pos*float2(0.5,-0.5)+0.5, 0, 1);
+            return v;
+        }"#, "main", "vs_6_6", &[]).unwrap();
+    let verts = [-1.0, -1.0, -1.0, 3.0, 3.0, -1.0];
+    let layout = [runner::VertexElement { semantic: "POSITION", index: 0, format: DXGI_FORMAT_R32G32_FLOAT, offset: 0 }];
+    let clear = [-3.0; 4];
+    runner::disable_driver_shader_cache().expect("cache disable");
+    let started = std::time::Instant::now();
+    let pixels = runner::draw_heap_windows_rect(&vs, &ps, &layout, &verts, 8, &sgprs, &[0; 256], 64, (size, height), clear).unwrap();
+    println!("scene_native_setup_submit_readback_ms={:.4}", started.elapsed().as_secs_f64() * 1000.0);
+    assert_eq!(pixels.len(), (size * height) as usize);
+    assert!(!pixels.contains(&clear), "incomplete coverage");
+    let file = std::fs::OpenOptions::new().write(true).create_new(true).open(image_path).unwrap();
+    let mut out = std::io::BufWriter::new(file);
+    for pixel in &pixels {
+        for channel in pixel {
+            out.write_all(&channel.to_le_bytes()).unwrap();
+        }
+    }
+    out.flush().unwrap();
+    println!("scene adapter={} size={} full_target_pixels={}", runner::adapter().unwrap(), size, pixels.len());
+}
