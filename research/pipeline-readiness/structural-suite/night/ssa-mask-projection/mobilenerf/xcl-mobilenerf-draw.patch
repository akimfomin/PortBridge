+#[cfg(test)]
+pub(crate) fn disable_driver_shader_cache() -> Result<(), String> {
+    let mut guard = GPU.lock().unwrap();
+    let gpu = guard.get_or_insert_with(init).as_ref().map_err(Clone::clone)?;
+    let device = gpu.dev.cast::<ID3D12Device9>().map_err(e)?;
+    let kinds = D3D12_SHADER_CACHE_KIND_FLAG_IMPLICIT_DRIVER_MANAGED
+        | D3D12_SHADER_CACHE_KIND_FLAG_IMPLICIT_D3D_CACHE_FOR_DRIVER;
+    unsafe { device.ShaderCacheControl(kinds, D3D12_SHADER_CACHE_CONTROL_FLAG_DISABLE) }.map_err(e)
+}
