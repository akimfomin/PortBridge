+    sgprs: &[u32],
+    mem: &[u32],
+    window_dwords: usize,
+    extent: (u32, u32),
+    clear: [f32; 4],
+) -> Result<Vec<[f32; 4]>, String> {
+    if window_dwords == 0 || !window_dwords.is_multiple_of(64) || mem.is_empty() ||
+        !mem.len().is_multiple_of(window_dwords) || mem.len() / window_dwords > crate::gpu::uma::MAX_HEAP_WINDOWS
+    {
+        return Err("invalid packed draw heap windows".into());
+    }
+    draw_gs_views(vs, None, ps, layout, vertices, stride, &[], sgprs, mem, &[], &[], extent, clear, Some(window_dwords), None)
 }
 
