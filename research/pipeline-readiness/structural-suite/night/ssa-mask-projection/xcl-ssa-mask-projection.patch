     pub static_used: Vec<([u32; 4], bool, super::ops::Sampler)>,
     pub sampler_base: u32,
     pub exec_cache: HashMap<(Block, Value, Value), Value>,
+    /// Opt-in pixel translation keeps the four unmodified ballot results behind the most
