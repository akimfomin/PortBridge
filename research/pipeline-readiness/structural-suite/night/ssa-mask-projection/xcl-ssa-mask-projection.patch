 crates/xcl/src/gpu/dxil/lanes.rs  | 136 ++++++++++++++++++++++++++++--
 crates/xcl/src/gpu/dxil/lower.rs  |  21 +++--
 3 files changed, 160 insertions(+), 18 deletions(-)

