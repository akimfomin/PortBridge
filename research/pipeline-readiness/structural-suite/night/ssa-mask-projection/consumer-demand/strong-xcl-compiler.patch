+                    state ^= state << 13;
+                    state ^= state >> 17;
+                    state ^= state << 5;
+                    match pattern {
+                        0 => 0,
+                        1 => if half == 0 { 0x8000_0000 } else { 0 },
+                        2 => if half == 1 { 0x8000_0000 } else { 0 },
+                        3..=18 => ((pattern - 3) as u32).rotate_left((4 * (p + half)) as u32),
+                        _ => state,
+                    }
