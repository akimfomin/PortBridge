+#[cfg(test)]
+mod known_bits_tests {
+    use super::*;
+    use crate::gpu::dxil::{
+        container::Stage,
+        ops::{Binary, BitCount},
+        shader::Shader,
+        validate,
+    };
+    use crate::gpu::recomp::runner;
