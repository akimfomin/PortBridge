+#[cfg(test)]
+struct PipelineMemorySample {
+    adapter: IDXGIAdapter3,
+}
+
+#[cfg(test)]
+impl PipelineMemorySample {
+    fn open(dev: &ID3D12Device) -> Result<Self, String> {
+        unsafe {
+            let factory: IDXGIFactory4 = CreateDXGIFactory1().map_err(e)?;
+            Ok(Self { adapter: factory.EnumAdapterByLuid(dev.GetAdapterLuid()).map_err(e)? })
+        }
+    }
+
+    fn record(&self, phase: &str) -> Result<(), String> {
+        use windows_sys::Win32::System::ProcessStatus::{K32GetProcessMemoryInfo, PROCESS_MEMORY_COUNTERS_EX};
+        use windows_sys::Win32::System::Threading::GetCurrentProcess;
+        unsafe {
+            let mut local = DXGI_QUERY_VIDEO_MEMORY_INFO::default();
+            let mut nonlocal = DXGI_QUERY_VIDEO_MEMORY_INFO::default();
+            self.adapter.QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &mut local).map_err(e)?;
+            self.adapter.QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, &mut nonlocal).map_err(e)?;
+            let mut process: PROCESS_MEMORY_COUNTERS_EX = std::mem::zeroed();
+            process.cb = std::mem::size_of_val(&process) as u32;
+            if K32GetProcessMemoryInfo(GetCurrentProcess(), (&mut process as *mut PROCESS_MEMORY_COUNTERS_EX).cast(), process.cb) == 0 {
+                return Err(std::io::Error::last_os_error().to_string());
+            }
+            println!("pso_memory phase={phase} local_bytes={} nonlocal_bytes={} local_budget={} nonlocal_budget={} private_bytes={} working_set_bytes={}",
+                     local.CurrentUsage, nonlocal.CurrentUsage, local.Budget, nonlocal.Budget, process.PrivateUsage, process.WorkingSetSize);
+        }
+        Ok(())
+    }
+}
