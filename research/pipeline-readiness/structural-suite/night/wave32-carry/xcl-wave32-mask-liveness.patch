 crates/xcl/src/gpu/recomp/tests.rs     | 44 +++++++++++++++++++++++
 crates/xcl/src/gpu/recomp/x64_masks.rs | 48 +++++++++++++++++++++++---
 4 files changed, 91 insertions(+), 5 deletions(-)

