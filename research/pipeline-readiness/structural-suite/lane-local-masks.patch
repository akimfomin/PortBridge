+    /// For a mask with no whole-value readers, each pixel can write its own EXEC-gated bit
+    /// directly, including on a helper lane. The other bits of HLSL `ballot_px_local` are dead.
+    pub fn pixel_lane_mask(&mut self, cond: Value) -> (Value, Value) {
+        let z = self.c(0);
+        let one = self.c(1);
+        let own_bit = self.bin(BinOp::Shl, one, self.lane31);
+        let own = self.sel(cond, own_bit, z);
+        if self.wave64 {
+            let upper = self.upper;
+            (self.sel(upper, z, own), self.sel(upper, own, z))
+        } else {
+            (own, z)
+        }
+    }
