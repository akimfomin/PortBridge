--- /dev/null
+++ b/crates/xcl/src/gpu/dxil/module/guard.rs
@@ -0,0 +1,269 @@
+//! Fuse repeated pixel read guards without speculating loads or moving wave operations.
+
+use std::collections::{HashMap, HashSet};
+
+use super::{BinOp, Block, CastOp, FnAttrs, Module, Op, Pred, Value};
+
+#[path = "guard_switch.rs"]
+mod switch;
+
+impl Module {
+    pub(super) fn fuse_read_guards(&mut self, order: &[u32]) -> bool {
+        let mut incoming = vec![0; self.blocks.len()];
+        let mut changed = false;
+        for &source in order {
+            for target in self.successors(source as usize) {
+                incoming[target.0 as usize] += 1;
+            }
+        }
+        for &source in order {
+            // Bound the size of a fused region and the work spent remapping it.
+            for _ in 1..8 {
+                if !self.fuse_guard_pair(Block(source), &incoming) {
+                    break;
+                }
+                changed = true;
+            }
+        }
+        changed
+    }
+
+    fn fuse_guard_pair(&mut self, source: Block, incoming: &[usize]) -> bool {
+        //    source - true -> first      middle - true -> second
+        //      |               |            |                 |
+        //    false ----------> middle     false ------------> join
+        let Some(head) = self.last_inst(source) else { return false };
+        let Op::CondBr(condition, first, middle) = self.insts[head].op else { return false };
+        let Some(first_end) = self.last_inst(first) else { return false };
+        let Some(middle_end) = self.last_inst(middle) else { return false };
+        let Op::CondBr(again, second, join) = self.insts[middle_end].op else { return false };
+        let Some(second_end) = self.last_inst(second) else { return false };
+        let mut distinct = [source.0, first.0, middle.0, second.0, join.0];
+        distinct.sort_unstable();
+        if condition != again || distinct.windows(2).any(|p| p[0] == p[1])
+            || !matches!(self.insts[first_end].op, Op::Br(b) if b == middle)
+            || !matches!(self.insts[second_end].op, Op::Br(b) if b == join)
+            || incoming[first.0 as usize] != 1 || incoming[middle.0 as usize] != 2
+            || incoming[second.0 as usize] != 1 || incoming[join.0 as usize] != 2
+            || !self.readonly_arm(first) || !self.readonly_arm(second)
+        {
+            return false;
+        }
+
+        let mid = &self.blocks[middle.0 as usize];
+        let phi_count = mid.iter().take_while(|&&i| matches!(self.insts[i as usize].op, Op::Phi(_))).count();
+        let mut phi_inputs = HashMap::new();
+        for &i in &mid[..phi_count] {
+            let Op::Phi(inputs) = &self.insts[i as usize].op else { unreachable!() };
+            let (Some(skip), Some(take)) = (phi_value(inputs, source), phi_value(inputs, first)) else { return false };
+            phi_inputs.insert(Value::Inst(i), (skip, take));
+        }
+        // Hoist independent integer arithmetic. Move read-dependent results,
+        // such as inactive-lane selects, after the final phis if the second
+        // region and its phi inputs do not use them.
+        let mut sinks = HashSet::new();
+        let uses_sink = |op: &Op, sinks: &HashSet<Value>| {
+            let mut uses = false;
+            op.for_each_operand(|v| uses |= sinks.contains(&v));
+            uses
+        };
+        for &i in &mid[phi_count..mid.len() - 1] {
+            if !self.guard_math(i) {
+                return false;
+            }
+            let mut depends_on_read = false;
+            self.insts[i as usize].op.for_each_operand(|value| {
+                depends_on_read |= phi_inputs.contains_key(&value) || sinks.contains(&value)
+                    || matches!(value, Value::Inst(j) if self.def_block[j as usize] == first);
+            });
+            if depends_on_read {
+                sinks.insert(Value::Inst(i));
+            }
+        }
+        if self.blocks[second.0 as usize].iter().any(|&i| uses_sink(&self.insts[i as usize].op, &sinks)) {
+            return false;
+        }
+        let mut join_phis = 0;
+        for &i in &self.blocks[join.0 as usize] {
+            let op = &self.insts[i as usize].op;
+            let Op::Phi(inputs) = op else { break };
+            if phi_value(inputs, middle).is_none() || phi_value(inputs, second).is_none()
+                || uses_sink(op, &sinks)
+            {
+                return false;
+            }
+            join_phis += 1;
+        }
+
+        let mut mid = std::mem::take(&mut self.blocks[middle.0 as usize]);
+        mid.pop();
+        let source_insts = &mut self.blocks[source.0 as usize];
+        source_insts.pop();
+        let mut sink_insts = Vec::new();
+        for i in mid.drain(phi_count..) {
+            if sinks.contains(&Value::Inst(i)) {
+                self.def_block[i as usize] = join;
+                sink_insts.push(i);
+            } else {
+                self.def_block[i as usize] = source;
+                source_insts.push(i);
+            }
+        }
+        self.insts[head].op = Op::CondBr(condition, first, join);
+        source_insts.push(head as u32);
+
+        let second_insts = std::mem::take(&mut self.blocks[second.0 as usize]);
+        let first_insts = &mut self.blocks[first.0 as usize];
+        first_insts.pop();
+        for i in second_insts {
+            self.insts[i as usize].op.map_operands(|v| phi_inputs.get(&v).map_or(v, |&(_, take)| take));
+            self.def_block[i as usize] = first;
+            first_insts.push(i);
+        }
+
+        let last = &mut self.blocks[join.0 as usize];
+        for &i in last.iter() {
+            let Op::Phi(inputs) = &mut self.insts[i as usize].op else { break };
+            for (value, label) in inputs {
+                let taken = *label == second;
+                if let Some(&(skip, take)) = phi_inputs.get(value) {
+                    *value = if taken { take } else { skip };
+                }
+                *label = if taken { first } else { source };
+            }
+        }
+        for &i in &mid {
+            self.def_block[i as usize] = join;
+        }
+        last.splice(join_phis..join_phis, sink_insts);
+        last.splice(..0, mid);
+        true
+    }
+
+    fn last_inst(&self, block: Block) -> Option<usize> {
+        self.blocks[block.0 as usize].last().map(|&i| i as usize)
+    }
+
+    fn guard_math(&self, i: u32) -> bool {
+        let inst = &self.insts[i as usize];
+        self.int_width(inst.ty).is_some() && match inst.op {
+            Op::Bin(BinOp::Add | BinOp::Sub | BinOp::And | BinOp::Or | BinOp::Xor, _, _, 0)
+            | Op::Cast(CastOp::ZExt | CastOp::SExt | CastOp::Trunc, _, _)
+            | Op::Select(..) => true,
+            Op::Cmp(predicate, _, _) => (predicate as u32) >= (Pred::Eq as u32),
+            _ => false,
+        }
+    }
+
+    fn readonly_arm(&self, block: Block) -> bool {
+        let body = &self.blocks[block.0 as usize];
+        let mut reads = false;
+        for &i in &body[..body.len() - 1] {
+            match &self.insts[i as usize].op {
+                Op::Call(f, _) => {
+                    let f = &self.funcs[*f as usize];
+                    match (f.name.as_str(), f.attrs) {
+                        ("dx.op.rawBufferLoad.i32", FnAttrs::ReadOnly) => reads = true,
+                        ("dx.op.annotateHandle" | "dx.op.createHandleFromBinding" | "dx.op.createHandleFromHeap",
+                         FnAttrs::ReadNone) => {}
+                        _ => return false,
+                    }
+                }
+                Op::Extract(..) => {}
+                _ if self.guard_math(i) => {}
+                _ => return false,
+            }
+        }
+        reads
+    }
+}
+
+fn phi_value(inputs: &[(Value, Block)], block: Block) -> Option<Value> {
+    if inputs.len() != 2 {
+        return None;
+    }
+    inputs.iter().find_map(|&(value, label)| (label == block).then_some(value))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn guarded_reads(changed_condition: bool, wave: bool, dependent_read: bool) -> (Module, [Block; 5], [Value; 4]) {
+        let mut m = Module::new();
+        m.define_entry("main");
+        let [start, first, middle, second, join] = [
+            m.entry_block(), m.new_block(), m.new_block(), m.new_block(), m.new_block(),
+        ];
+        let i32 = m.i32();
+        let read_ty = m.func_ty(i32, &[i32]);
+        let read = m.declare("dx.op.rawBufferLoad.i32", read_ty, FnAttrs::ReadOnly);
+        let wave_read = m.declare("dx.op.waveReadLaneFirst.i32", read_ty, FnAttrs::NoUnwind);
+        let z = m.i32c(0);
+        let four = m.i32c(4);
+        let eight = m.i32c(8);
+        m.set_block(start);
+        let offset = m.call(read, &[z]);
+        let condition = m.cmp(Pred::ULt, offset, four);
+        let again = if changed_condition { m.cmp(Pred::ULt, offset, eight) } else { condition };
+        m.cond_br(condition, first, middle);
+        m.set_block(first);
+        let first_read = m.call(read, &[offset]);
+        m.br(middle);
+        m.set_block(middle);
+        let saved = m.phi(i32);
+        m.add_incoming(saved, z, start);
+        m.add_incoming(saved, first_read, first);
+        let masked = m.select(condition, saved, z);
+        let offset2 = m.bin(BinOp::Add, offset, four);
+        m.cond_br(again, second, join);
+        m.set_block(second);
+        let second_read = m.call(read, &[if dependent_read { masked } else { offset2 }]);
+        if wave { m.call(wave_read, &[second_read]); }
+        let sum = m.bin(BinOp::Add, saved, second_read);
+        m.br(join);
+        m.set_block(join);
+        let result = m.phi(i32);
+        m.add_incoming(result, saved, middle);
+        m.add_incoming(result, sum, second);
+        m.ret();
+        (m, [start, first, middle, second, join], [result, sum, first_read, masked])
+    }
+
+    #[test]
+    fn fuses_read_regions_and_rewrites_phis_on_both_paths() {
+        let (mut m, [start, first, middle, second, join], [result, sum, first_read, masked]) =
+            guarded_reads(false, false, false);
+        let order: Vec<_> = m.block_layout().0.iter().map(|&b| b as u32).collect();
+        assert!(m.fuse_read_guards(&order));
+        assert!(m.blocks[middle.0 as usize].is_empty() && m.blocks[second.0 as usize].is_empty());
+        assert_eq!(m.successors(start.0 as usize), [first, join]);
+        assert_eq!(m.successors(first.0 as usize), [join]);
+        let (Value::Inst(result), Value::Inst(sum)) = (result, sum) else { unreachable!() };
+        let Op::Phi(inputs) = &m.insts[result as usize].op else { unreachable!() };
+        let z = m.const_u64(phi_value(inputs, start).unwrap());
+        assert_eq!(z, Some(0));
+        assert_eq!(phi_value(inputs, first), Some(Value::Inst(sum)));
+        assert!(matches!(m.insts[sum as usize].op, Op::Bin(BinOp::Add, v, _, _) if v == first_read));
+        assert_eq!(m.def_block[sum as usize], first);
+        let Value::Inst(masked) = masked else { unreachable!() };
+        assert_eq!(m.def_block[masked as usize], join);
+        assert_eq!(m.blocks[join.0 as usize][2], masked);
+    }
+
+    #[test]
+    fn preserves_distinct_conditions_wave_operations_and_dependent_reads() {
+        for (changed_condition, wave, dependent_read) in [
+            (true, false, false), (false, true, false), (false, false, true),
+        ] {
+            let (mut m, _, _) = guarded_reads(changed_condition, wave, dependent_read);
+            let order: Vec<_> = m.block_layout().0.iter().map(|&b| b as u32).collect();
+            assert!(!m.fuse_read_guards(&order));
+            assert_eq!(m.block_layout().0.len(), 5);
+        }
+    }
+}
